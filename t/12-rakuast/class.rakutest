subtest 'class with an also statement' => {
    my role TestAlsoRole {
        method test-meth { 'also role meth' }
    }

    # my class TestAlsoTarget {
    #     also does TestAlsoRole
    # }
    ast RakuAST::Class.new(
      scope => 'my',
      name  => RakuAST::Name.from-identifier('TestAlsoTarget'),
      body  => RakuAST::Block.new(
        body => RakuAST::Blockoid.new(
          RakuAST::StatementList.new(
            RakuAST::Statement::Also.new(
              traits => (
                RakuAST::Trait::Does.new(
                  RakuAST::Type::Simple.new(
                    RakuAST::Name.from-identifier('TestAlsoRole')
                  )
                ),
              )
            )
          )
        )
      )
    );
    is-deeply $deparsed, q:to/CODE/.chomp, 'deparse';
my class TestAlsoTarget {
    also does TestAlsoRole
}
CODE

    for
      'AST', EVAL($ast),
      'Str', EVAL($deparsed),
      'Raku', EVAL(EVAL $raku)
    -> $type, $class {
        ok $class ~~ TestAlsoRole,
          "$type: the class does the role of the also statement";
        is $class.test-meth, 'also role meth',
          "$type: the role method can be called";
    }

    # my role TestAlsoOuter {
    #     method inner {
    #         42
    #     }
    # }
    # my class TestAlsoOrder {
    #     method outer {
    #         self.inner
    #     }
    #     also does TestAlsoOuter
    # }
    # TestAlsoOrder.outer
    #
    # the also statement stays where it was written
    my $parsed := Q:to/SOURCE/.AST;
    my role TestAlsoOuter { method inner { 42 } }
    my class TestAlsoOrder {
        method outer { self.inner }
        also does TestAlsoOuter;
    }
    TestAlsoOrder.outer
    SOURCE
    is-deeply $parsed.DEPARSE, Q:to/CODE/, 'deparse of a parsed also';
my role TestAlsoOuter {
    method inner {
        42
    }
}
my class TestAlsoOrder {
    method outer {
        self.inner
    }
    also does TestAlsoOuter
}
TestAlsoOrder.outer
CODE
    for
      'AST', EVAL($parsed),
      'Str', EVAL($parsed.DEPARSE),
      'Raku', EVAL(EVAL 'use experimental :rakuast; ' ~ $parsed.raku)
    -> $type, $value {
        is $value, 42, "$type: the role of the also statement is composed";
    }
}

subtest 'also statements in a role, a sub and a method' => {
    # my role TestAlsoBase {
    #     method base {
    #         42
    #     }
    # }
    # my role TestAlsoVia {
    #     also does TestAlsoBase
    # }
    # my class TestAlsoUser {
    #     also does TestAlsoVia
    # }
    # sub also-pure {
    #     also is pure;
    #     TestAlsoUser.base
    # }
    # my method also-rw {
    #     also is rw;
    #     also-pure()
    # }
    # (&also-pure.is-pure, &also-rw.rw, also-rw(TestAlsoUser))
    #
    # a role body is a routine, the statement reaches the role
    my $parsed := Q:to/SOURCE/.AST;
    my role TestAlsoBase { method base { 42 } }
    my role TestAlsoVia { also does TestAlsoBase }
    my class TestAlsoUser { also does TestAlsoVia }
    my sub also-pure { also is pure; TestAlsoUser.base }
    my method also-rw { also is rw; also-pure() }
    (&also-pure.is-pure, &also-rw.rw, also-rw(TestAlsoUser))
    SOURCE
    is-deeply $parsed.DEPARSE, Q:to/CODE/, 'deparse of also in a role, a sub and a method';
my role TestAlsoBase {
    method base {
        42
    }
}
my role TestAlsoVia {
    also does TestAlsoBase
}
my class TestAlsoUser {
    also does TestAlsoVia
}
sub also-pure {
    also is pure;
    TestAlsoUser.base
}
my method also-rw {
    also is rw;
    also-pure()
}
(&also-pure.is-pure, &also-rw.rw, also-rw(TestAlsoUser))
CODE
    for
      'AST', EVAL($parsed),
      'Str', EVAL($parsed.DEPARSE),
      'Raku', EVAL(EVAL 'use experimental :rakuast; ' ~ $parsed.raku)
    -> $type, $value {
        is-deeply $value, (True, True, 42),
          "$type: each also statement reached the routine or role it is in";
    }

    # also is rw
    #
    # an also statement outside a package or routine is an error
    my $alone := RakuAST::StatementList.new(
      RakuAST::Statement::Also.new(
        traits => (
          RakuAST::Trait::Is.new(name => RakuAST::Name.from-identifier('rw')),
        )
      )
    );
    is-deeply $alone.DEPARSE, "also is rw\n", 'deparse of an also without a target';
    throws-like { EVAL($alone) }, Exception,
      message => /"Could not find target for 'also'"/,
      'an also statement without a target does not compile';
    is do { try EVAL($alone); $!.message.comb("Could not find target").elems }, 1,
      'the missing target is reported once';

    # my class TestAlsoEmpty {
    #     also
    # }
    throws-like {
        EVAL RakuAST::Class.new(
          scope => 'my',
          name  => RakuAST::Name.from-identifier('TestAlsoEmpty'),
          body  => RakuAST::Block.new(
            body => RakuAST::Blockoid.new(
              RakuAST::StatementList.new(RakuAST::Statement::Also.new)
            )
          )
        )
    }, Exception, message => /"No valid trait found after 'also'"/,
      'an also statement without traits does not compile';
}


subtest 'unit scoped module that ends in a doc block' => {
    # unit module TestUnitDoc;
    # =para text
    #
    my $parsed := Q:to/SOURCE/.AST;
    unit module TestUnitDoc;
    =para text

    SOURCE
    is-deeply $parsed.DEPARSE, Q:to/CODE/, 'deparse';
unit module TestUnitDoc;
=para text

CODE
}

subtest 'A trusts statement stays where it was written' => {
    # my class Outer {
    #     method !secret {
    #         42
    #     }
    #     my class Peeker {...}
    #     trusts Peeker;
    #     my class Peeker {
    #         method peek (Outer $o) {
    #             $o!Outer::secret
    #         }
    #     }
    #     method peeker {
    #         Peeker
    #     }
    # }
    # Outer.peeker.peek(Outer.new)
    ast Q:to/SOURCE/.AST;
    my class Outer {
        method !secret { 42 }
        my class Peeker { ... };
        trusts Peeker;
        my class Peeker { method peek(Outer $o) { $o!Outer::secret } }
        method peeker { Peeker }
    }
    Outer.peeker.peek(Outer.new)
    SOURCE
    is-deeply $deparsed, Q:to/CODE/, 'deparse';
my class Outer {
    method !secret {
        42
    }
    my class Peeker {...}
    trusts Peeker;
    my class Peeker {
        method peek (Outer $o) {
            $o!Outer::secret
        }
    }
    method peeker {
        Peeker
    }
}
Outer.peeker.peek(Outer.new)
CODE
    isa-ok $ast.statements.head.expression.body.body.statement-list.statements[2],
      RakuAST::Statement::Trusts, 'the statement is a trusts statement';

    for 'AST', $ast, 'Str', $deparsed -> $type, $it {
        is-deeply EVAL($it), 42, "$type: the trusted class calls the private method";
    }
    is-deeply EVAL($raku).DEPARSE, $deparsed, 'Raku: deparses the same';
}

subtest 'A hand built trusts statement' => {
    # my class TrustsBase { }
    # my class TrustsStatement {
    #     trusts TrustsBase
    # }
    ast RakuAST::StatementList.new(
      RakuAST::Statement::Expression.new(
        expression => RakuAST::Class.new(
          scope => 'my',
          name  => RakuAST::Name.from-identifier('TrustsBase')
        )
      ),
      RakuAST::Statement::Expression.new(
        expression => RakuAST::Class.new(
          scope => 'my',
          name  => RakuAST::Name.from-identifier('TrustsStatement'),
          body  => RakuAST::Block.new(
            body => RakuAST::Blockoid.new(
              RakuAST::StatementList.new(
                RakuAST::Statement::Trusts.new(
                  type => RakuAST::Type::Simple.new(
                    RakuAST::Name.from-identifier('TrustsBase')
                  )
                )
              )
            )
          )
        )
      )
    );
    is-deeply $deparsed, Q:to/CODE/, 'deparse';
my class TrustsBase { }
my class TrustsStatement {
    trusts TrustsBase
}
CODE

    for 'AST', $ast, 'Str', $deparsed, 'Raku', EVAL($raku) -> $type, $it {
        my $class := EVAL($it);
        is-deeply $class.^trusts.map(*.^name).List, ('TrustsBase',),
          "$type: the class trusts the base";
    }
}

subtest 'A trusts statement outside a package' => {
    # trusts Int
    ast RakuAST::Statement::Trusts.new(
      type => RakuAST::Type::Simple.new(RakuAST::Name.from-identifier('Int'))
    );
    is-deeply $deparsed, 'trusts Int', 'deparse';
    isa-ok $ast.trait, RakuAST::Trait::Trusts, 'the statement holds its trait';
    for 'AST', $ast, 'Raku', EVAL($raku) -> $type, $it {
        throws-like { EVAL($it) }, Exception,
          message => /"Could not find target for 'trusts'"/,
          "$type: no package to trust from";
    }
    dies-ok { EVAL($deparsed) }, 'Str: no package to trust from';
}

subtest 'A declarator a module added is written as it was' => {
    # use CustomDeclarator;
    # my custom-class CustomDeclared { }
    ast RakuAST::StatementList.new(
      RakuAST::Statement::Use.new(
        module-name => RakuAST::Name.from-identifier('CustomDeclarator')
      ),
      RakuAST::Statement::Expression.new(
        expression => RakuAST::Class.new(
          scope             => 'my',
          parsed-declarator => 'custom-class',
          name              => RakuAST::Name.from-identifier('CustomDeclared'),
          how               => CustomDeclaratorHOW
        )
      )
    );
    is-deeply $deparsed, Q:to/CODE/, 'deparse';
use CustomDeclarator;
my custom-class CustomDeclared { }
CODE

    for
      'AST', EVAL($ast),
      'Str', EVAL($deparsed),
      'Raku', EVAL(EVAL $raku)
    -> $type, $class {
        is $class.^name, 'CustomDeclared', "$type: the class is declared";
        is $class.HOW.^name, 'CustomDeclaratorHOW',
          "$type: the declarator's HOW builds the class";
    }
    is-deeply EVAL($raku).DEPARSE, $deparsed,
      'Raku: the declarator survives the .raku';

    # use CustomDeclarator;
    # my custom-class CustomResolved { }
    ast RakuAST::StatementList.new(
      RakuAST::Statement::Use.new(
        module-name => RakuAST::Name.from-identifier('CustomDeclarator')
      ),
      RakuAST::Statement::Expression.new(
        expression => RakuAST::Class.new(
          scope             => 'my',
          parsed-declarator => 'custom-class',
          name              => RakuAST::Name.from-identifier('CustomResolved')
        )
      )
    );
    is-deeply $deparsed, Q:to/CODE/, 'deparse: a declarator given no how';
use CustomDeclarator;
my custom-class CustomResolved { }
CODE

    for
      'AST', EVAL($ast),
      'Str', EVAL($deparsed),
      'Raku', EVAL(EVAL $raku)
    -> $type, $class {
        is $class.^name, 'CustomResolved',
          "$type: the class given no how is declared";
        is $class.HOW.^name, 'CustomDeclaratorHOW',
          "$type: the HOW the module added builds the class given no how";
    }
    nok $ast.raku.contains(/<< how >> \s* '=>'/),
      'Raku: the HOW the declarator resolved to is not written';

    my $parsed := Q:to/CODE/.AST;
use CustomDeclarator;
custom-class CustomParsed { }
CODE
    is-deeply $parsed.DEPARSE, Q:to/CODE/, 'parsed: the declarator is written as it was';
use CustomDeclarator;
custom-class CustomParsed { }
CODE
    is-deeply $parsed.statements[1].expression.parsed-declarator, 'custom-class',
      'parsed: the node keeps the declarator';

    is-deeply "use CustomDeclarator;\nunit custom-class CustomUnit;\n".AST.DEPARSE,
      "use CustomDeclarator;\nunit custom-class CustomUnit;\n",
      'parsed: a unit scoped declaration keeps the declarator';

    my $parsed-lexical := Q:to/CODE/.AST;
use CustomDeclarator;
my custom-class CustomParsedLexical { }
CODE
    nok $parsed-lexical.raku.contains(/<< how >> \s* '=>'/),
      "parsed: the declarator's HOW is not written in the .raku";
    is EVAL(EVAL 'use experimental :rakuast; ' ~ $parsed-lexical.raku).HOW.^name,
      'CustomDeclaratorHOW',
      "parsed: the .raku builds the class with the declarator's HOW";
}

subtest 'A declarator a module superseded resolves in a tree' => {
    # use SupersedeDeclarator;
    # my class Superseded {
    #     has $.a
    # }
    ast RakuAST::StatementList.new(
      RakuAST::Statement::Use.new(
        module-name => RakuAST::Name.from-identifier('SupersedeDeclarator')
      ),
      RakuAST::Statement::Expression.new(
        expression => RakuAST::Class.new(
          scope => 'my',
          name  => RakuAST::Name.from-identifier('Superseded'),
          body  => RakuAST::Block.new(
            body => RakuAST::Blockoid.new(
              RakuAST::StatementList.new(
                RakuAST::Statement::Expression.new(
                  expression => RakuAST::VarDeclaration::Simple.new(
                    scope       => 'has',
                    sigil       => '$',
                    twigil      => '.',
                    desigilname => RakuAST::Name.from-identifier('a')
                  )
                )
              )
            )
          )
        )
      )
    );
    is-deeply $deparsed, Q:to/CODE/, 'deparse';
use SupersedeDeclarator;
my class Superseded {
    has $.a
}
CODE

    for
      'AST', EVAL($ast),
      'Str', EVAL($deparsed),
      'Raku', EVAL(EVAL $raku)
    -> $type, $class {
        is $class.HOW.^name, 'SupersededClassHOW',
          "$type: the class is made with the superseding HOW";
        is $class.^attributes.head.^name, 'SupersededAttribute',
          "$type: the attribute is made with the superseding attribute type";
    }

    my $parsed := Q:to/CODE/.AST;
use SupersedeDeclarator;
my class SupersededParsed {
    has $.a
}
CODE
    nok $parsed.raku.contains(/<< how >> \s* '=>'/),
      'parsed: the superseding HOW is not written in the .raku';
    my $class := EVAL(EVAL 'use experimental :rakuast; ' ~ $parsed.raku);
    is $class.HOW.^name, 'SupersededClassHOW',
      'parsed: the .raku makes the class with the superseding HOW';
    is $class.^attributes.head.^name, 'SupersededAttribute',
      'parsed: the .raku makes the attribute with the superseding attribute type';
}

subtest 'A unit scoped declarator a module added resolves in a tree' => {
    for 'AST', 'Str', 'Raku' -> $type {
        my $name := "CustomUnit$type";

        # use CustomDeclarator;
        # unit custom-class CustomUnit$type;
        # method m {
        #     42
        # }
        ast RakuAST::StatementList.new(
          RakuAST::Statement::Use.new(
            module-name => RakuAST::Name.from-identifier('CustomDeclarator')
          ),
          RakuAST::Statement::Expression.new(
            expression => RakuAST::Class.new(
              scope             => 'unit',
              parsed-declarator => 'custom-class',
              name              => RakuAST::Name.from-identifier($name),
              body              => RakuAST::Block.new(
                body => RakuAST::Blockoid.new(
                  RakuAST::StatementList.new(
                    RakuAST::Statement::Expression.new(
                      expression => RakuAST::Method.new(
                        name => RakuAST::Name.from-identifier('m'),
                        body => RakuAST::Blockoid.new(
                          RakuAST::StatementList.new(
                            RakuAST::Statement::Expression.new(
                              expression => RakuAST::IntLiteral.new(42)
                            )
                          )
                        )
                      )
                    )
                  )
                )
              )
            )
          )
        );
        is-deeply $deparsed, qq:to/CODE/, "$type: deparse";
use CustomDeclarator;
unit custom-class $name;
method m \{
    42
}
CODE

        my $class := EVAL($type eq 'AST'
          ?? $ast
          !! $type eq 'Str'
            ?? $deparsed
            !! EVAL $raku
        );
        is $class.HOW.^name, 'CustomDeclaratorHOW',
          "$type: the unit scoped class is made with the declarator's HOW";
        is-deeply $class.m, 42, "$type: the unit scoped class has its method";
    }
}

subtest 'A declarator no module added is a sorry' => {
    # my nonesuch Unresolved { }
    ast RakuAST::Class.new(
      scope             => 'my',
      parsed-declarator => 'nonesuch',
      name              => RakuAST::Name.from-identifier('Unresolved')
    );
    is-deeply $deparsed, 'my nonesuch Unresolved { }', 'deparse';

    throws-like { EVAL($ast) }, X::Comp,
      message => /'Cannot resolve meta-object for nonesuch'/,
      'AST: the declarator is not known';
    dies-ok { EVAL($deparsed) }, 'Str: the declarator does not parse';
    throws-like { EVAL(EVAL $raku) }, X::Comp,
      message => /'Cannot resolve meta-object for nonesuch'/,
      'Raku: the declarator is not known';
}

subtest 'A how given by hand is kept over a superseding declarator' => {
    # use SupersedeDeclarator;
    # my class GivenHow {
    #     has $.a
    # }
    ast RakuAST::StatementList.new(
      RakuAST::Statement::Use.new(
        module-name => RakuAST::Name.from-identifier('SupersedeDeclarator')
      ),
      RakuAST::Statement::Expression.new(
        expression => RakuAST::Class.new(
          scope => 'my',
          name  => RakuAST::Name.from-identifier('GivenHow'),
          how   => Metamodel::ClassHOW,
          body  => RakuAST::Block.new(
            body => RakuAST::Blockoid.new(
              RakuAST::StatementList.new(
                RakuAST::Statement::Expression.new(
                  expression => RakuAST::VarDeclaration::Simple.new(
                    scope       => 'has',
                    sigil       => '$',
                    twigil      => '.',
                    desigilname => RakuAST::Name.from-identifier('a')
                  )
                )
              )
            )
          )
        )
      )
    );
    is-deeply $deparsed, Q:to/CODE/, 'deparse';
use SupersedeDeclarator;
my class GivenHow {
    has $.a
}
CODE
    ok $raku.contains(/<< how >> \s* '=>'/),
      'Raku: the how given by hand is written';

    for
      'AST', EVAL($ast),
      'Raku', EVAL(EVAL $raku)
    -> $type, $class {
        is $class.HOW.^name, 'Perl6::Metamodel::ClassHOW',
          "$type: the class is made with the how given by hand";
        is $class.^attributes.head.^name, 'SupersededAttribute',
          "$type: the attribute type is resolved apart from the how";
    }

    my $class := EVAL($deparsed);
    is $class.HOW.^name, 'SupersededClassHOW',
      'Str: the deparse carries no how and takes the superseding HOW';
    is $class.^attributes.head.^name, 'SupersededAttribute',
      'Str: the deparse takes the superseding attribute type';
}

subtest 'A declarator a module added resolves in the scope of its use' => {
    # {
    #     use CustomDeclarator;
    #     my custom-class InBlock { }
    # }
    ast RakuAST::StatementList.new(
      RakuAST::Statement::Expression.new(
        expression => RakuAST::Block.new(
          body => RakuAST::Blockoid.new(
            RakuAST::StatementList.new(
              RakuAST::Statement::Use.new(
                module-name => RakuAST::Name.from-identifier('CustomDeclarator')
              ),
              RakuAST::Statement::Expression.new(
                expression => RakuAST::Class.new(
                  scope             => 'my',
                  parsed-declarator => 'custom-class',
                  name              => RakuAST::Name.from-identifier('InBlock')
                )
              )
            )
          )
        )
      )
    );
    is-deeply $deparsed, Q:to/CODE/, 'deparse: a use in a block';
{
    use CustomDeclarator;
    my custom-class InBlock { }
}
CODE

    for
      'AST', EVAL($ast),
      'Str', EVAL($deparsed),
      'Raku', EVAL(EVAL $raku)
    -> $type, $class {
        is $class.HOW.^name, 'CustomDeclaratorHOW',
          "$type: a package in the block of the use resolves the declarator";
    }

    # my class OuterBody {
    #     use CustomDeclarator;
    #     custom-class InBody { }
    # }
    ast RakuAST::Class.new(
      scope => 'my',
      name  => RakuAST::Name.from-identifier('OuterBody'),
      body  => RakuAST::Block.new(
        body => RakuAST::Blockoid.new(
          RakuAST::StatementList.new(
            RakuAST::Statement::Use.new(
              module-name => RakuAST::Name.from-identifier('CustomDeclarator')
            ),
            RakuAST::Statement::Expression.new(
              expression => RakuAST::Class.new(
                scope             => 'our',
                parsed-declarator => 'custom-class',
                name              => RakuAST::Name.from-identifier('InBody')
              )
            )
          )
        )
      )
    );
    is-deeply $deparsed, Q:to/CODE/.chomp, 'deparse: a use in a package body';
my class OuterBody {
    use CustomDeclarator;
    custom-class InBody { }
}
CODE

    for
      'AST', EVAL($ast),
      'Str', EVAL($deparsed),
      'Raku', EVAL(EVAL $raku)
    -> $type, $class {
        is $class.WHO<InBody>.HOW.^name, 'CustomDeclaratorHOW',
          "$type: a package in the package body of the use resolves the declarator";
    }

    # {
    #     use CustomDeclarator
    # }
    # my custom-class AfterBlock { }
    ast RakuAST::StatementList.new(
      RakuAST::Statement::Expression.new(
        expression => RakuAST::Block.new(
          body => RakuAST::Blockoid.new(
            RakuAST::StatementList.new(
              RakuAST::Statement::Use.new(
                module-name => RakuAST::Name.from-identifier('CustomDeclarator')
              )
            )
          )
        )
      ),
      RakuAST::Statement::Expression.new(
        expression => RakuAST::Class.new(
          scope             => 'my',
          parsed-declarator => 'custom-class',
          name              => RakuAST::Name.from-identifier('AfterBlock')
        )
      )
    );
    is-deeply $deparsed, Q:to/CODE/, 'deparse: a package after the block of the use';
{
    use CustomDeclarator
}
my custom-class AfterBlock { }
CODE

    throws-like { EVAL($ast) }, X::Comp,
      message => /'Cannot resolve meta-object for custom-class'/,
      'AST: the declarator is not known after the block of the use';
    dies-ok { EVAL($deparsed) },
      'Str: the declarator does not parse after the block of the use';
    throws-like { EVAL(EVAL $raku) }, X::Comp,
      message => /'Cannot resolve meta-object for custom-class'/,
      'Raku: the declarator is not known after the block of the use';
}

subtest 'A declarator a module supersedes unchecked resolves in a tree' => {
    # use UncheckedDeclarator;
    # my grammar Unchecked { }
    ast RakuAST::StatementList.new(
      RakuAST::Statement::Use.new(
        module-name => RakuAST::Name.from-identifier('UncheckedDeclarator')
      ),
      RakuAST::Statement::Expression.new(
        expression => RakuAST::Grammar.new(
          scope => 'my',
          name  => RakuAST::Name.from-identifier('Unchecked')
        )
      )
    );
    is-deeply $deparsed, Q:to/CODE/, 'deparse';
use UncheckedDeclarator;
my grammar Unchecked { }
CODE

    for
      'AST', EVAL($ast),
      'Str', EVAL($deparsed),
      'Raku', EVAL(EVAL $raku)
    -> $type, $grammar {
        is $grammar.HOW.^name, 'UncheckedGrammarHOW',
          "$type: the grammar is made with the superseding HOW";
    }

    my $parsed := Q:to/CODE/.AST;
use UncheckedDeclarator;
my grammar UncheckedParsed { }
CODE
    nok $parsed.raku.contains(/<< how >> \s* '=>'/),
      'parsed: the superseding HOW is not written in the .raku';
    is EVAL(EVAL 'use experimental :rakuast; ' ~ $parsed.raku).HOW.^name,
      'UncheckedGrammarHOW',
      'parsed: the .raku makes the grammar with the superseding HOW';
}

subtest 'An attribute default read from a typed attribute or lexical' => {
    # my class AttrDefaultFromAttr { has Int $.a = 1; has Int $.b = $!a }
    ast Q:to/CODE/.AST;
my class AttrDefaultFromAttr { has Int $.a = 1; has Int $.b = $!a }
CODE
    is EVAL($ast).new.b, 1, 'a default read from an attribute of the same type';

    # my class AttrDefaultDefinite { has Int:D $.a = 1; has Int:D $.b = $!a }
    ast Q:to/CODE/.AST;
my class AttrDefaultDefinite { has Int:D $.a = 1; has Int:D $.b = $!a }
CODE
    is EVAL($ast).new.b, 1, 'a default read into a definite type';

    # my Numeric $n = 2; my class AttrDefaultFromLexical { has Numeric $.b = $n }
    ast Q:to/CODE/.AST;
my Numeric $n = 2; my class AttrDefaultFromLexical { has Numeric $.b = $n }
CODE
    is EVAL($ast).new.b, 2, 'a default read from a typed lexical';

    # my class AttrDefaultCoercion { has Int:D $.a = 1; has Int:D(Rat) $.b = $!a }
    ast Q:to/CODE/.AST;
my class AttrDefaultCoercion { has Int:D $.a = 1; has Int:D(Rat) $.b = $!a }
CODE
    is EVAL($ast).new.b, 1, 'a default read into a coercion of a definite type';

    # my class AttrDefaultCoerced { has Rat $.r = 1.5; has Int(Rat) $.b = $!r }
    ast Q:to/CODE/.AST;
my class AttrDefaultCoerced { has Rat $.r = 1.5; has Int(Rat) $.b = $!r }
CODE
    is EVAL($ast).new.b, 1, 'a default the coercion type coerces at runtime';

    # my class AttrDefaultCoercionLiteral { has Int:D(Rat) $.x = "42" }
    throws-like {
        'my class AttrDefaultCoercionLiteral { has Int:D(Rat) $.x = "42" }'.AST
    }, X::TypeCheck::Attribute::Default,
      name => '$!x', got => 'Str', expected => 'Int:D(Rat)',
      'a literal of another type is reported for a coercion of a definite type';

    # my class AttrDefaultWrongType { has Str $.s = "x"; has Int $.b = $!s }
    throws-like {
        'my class AttrDefaultWrongType { has Str $.s = "x"; has Int $.b = $!s }'.AST
    }, X::TypeCheck::Attribute::Default,
      name => '$!b', got => 'Str', expected => 'Int',
      'a default of another type is reported';
}

subtest 'A class whose version, auth and api need evaluation' => {
    # my class ComputedClass:ver(1 + 1):auth("x" ~ "y"):api(2 + 1) {
    #     has $.a
    # }
    ast RakuAST::Class.new(
      scope => 'my',
      name  => RakuAST::Name.from-identifier('ComputedClass',
        colonpairs => (
          RakuAST::ColonPair::Value.new(
            key   => 'ver',
            value => RakuAST::Circumfix::Parentheses.new(
              RakuAST::SemiList.new(
                RakuAST::Statement::Expression.new(
                  expression => RakuAST::ApplyInfix.new(
                    left  => RakuAST::IntLiteral.new(1),
                    infix => RakuAST::Infix.new('+'),
                    right => RakuAST::IntLiteral.new(1)
                  )
                )
              )
            )
          ),
          RakuAST::ColonPair::Value.new(
            key   => 'auth',
            value => RakuAST::Circumfix::Parentheses.new(
              RakuAST::SemiList.new(
                RakuAST::Statement::Expression.new(
                  expression => RakuAST::ApplyInfix.new(
                    left  => RakuAST::QuotedString.new(
                      segments => (RakuAST::StrLiteral.new('x'),)
                    ),
                    infix => RakuAST::Infix.new('~'),
                    right => RakuAST::QuotedString.new(
                      segments => (RakuAST::StrLiteral.new('y'),)
                    )
                  )
                )
              )
            )
          ),
          RakuAST::ColonPair::Value.new(
            key   => 'api',
            value => RakuAST::Circumfix::Parentheses.new(
              RakuAST::SemiList.new(
                RakuAST::Statement::Expression.new(
                  expression => RakuAST::ApplyInfix.new(
                    left  => RakuAST::IntLiteral.new(2),
                    infix => RakuAST::Infix.new('+'),
                    right => RakuAST::IntLiteral.new(1)
                  )
                )
              )
            )
          ),
        )
      ),
      body  => RakuAST::Block.new(
        body => RakuAST::Blockoid.new(
          RakuAST::StatementList.new(
            RakuAST::Statement::Expression.new(
              expression => RakuAST::VarDeclaration::Simple.new(
                scope       => 'has',
                sigil       => '$',
                twigil      => '.',
                desigilname => RakuAST::Name.from-identifier('a')
              )
            )
          )
        )
      )
    );
    is-deeply $deparsed, q:to/CODE/.chomp, 'deparse';
my class ComputedClass:ver(1 + 1):auth("x" ~ "y"):api(2 + 1) {
    has $.a
}
CODE

    for
      'AST', EVAL($ast),
      'Str', EVAL($deparsed),
      'Raku', EVAL(EVAL $raku)
    -> $type, $class {
        is-deeply $class.^ver, v2, "$type: the class has the computed version";
        is-deeply $class.^auth, 'xy', "$type: the class has the computed auth";
        is-deeply $class.^api, '3', "$type: the class has the computed api";
        is $class.new(a => 42).a, 42, "$type: the attribute is attached";
    }
}

subtest 'A class with a literal version and an auth that needs evaluation' => {
    # my class MixedVersionClass:ver<1.2>:auth("x" ~ "y") { }
    ast RakuAST::Class.new(
      scope => 'my',
      name  => RakuAST::Name.from-identifier('MixedVersionClass',
        colonpairs => (
          RakuAST::ColonPair::Value.new(
            key   => 'ver',
            value => RakuAST::QuotedString.new(
              processors => <words val>,
              segments   => (RakuAST::StrLiteral.new('1.2'),)
            )
          ),
          RakuAST::ColonPair::Value.new(
            key   => 'auth',
            value => RakuAST::Circumfix::Parentheses.new(
              RakuAST::SemiList.new(
                RakuAST::Statement::Expression.new(
                  expression => RakuAST::ApplyInfix.new(
                    left  => RakuAST::QuotedString.new(
                      segments => (RakuAST::StrLiteral.new('x'),)
                    ),
                    infix => RakuAST::Infix.new('~'),
                    right => RakuAST::QuotedString.new(
                      segments => (RakuAST::StrLiteral.new('y'),)
                    )
                  )
                )
              )
            )
          ),
        )
      )
    );
    is-deeply $deparsed, 'my class MixedVersionClass:ver<1.2>:auth("x" ~ "y") { }',
      'deparse';

    for
      'AST', EVAL($ast),
      'Str', EVAL($deparsed),
      'Raku', EVAL(EVAL $raku)
    -> $type, $class {
        is-deeply $class.^ver, v1.2, "$type: the class has the literal version";
        is-deeply $class.^auth, 'xy', "$type: the class has the computed auth";
    }
}

subtest 'A module whose auth needs evaluation' => {
    # my module ComputedModule:auth("x" ~ "y") { }
    ast RakuAST::Module.new(
      scope => 'my',
      name  => RakuAST::Name.from-identifier('ComputedModule',
        colonpairs => (
          RakuAST::ColonPair::Value.new(
            key   => 'auth',
            value => RakuAST::Circumfix::Parentheses.new(
              RakuAST::SemiList.new(
                RakuAST::Statement::Expression.new(
                  expression => RakuAST::ApplyInfix.new(
                    left  => RakuAST::QuotedString.new(
                      segments => (RakuAST::StrLiteral.new('x'),)
                    ),
                    infix => RakuAST::Infix.new('~'),
                    right => RakuAST::QuotedString.new(
                      segments => (RakuAST::StrLiteral.new('y'),)
                    )
                  )
                )
              )
            )
          ),
        )
      )
    );
    is-deeply $deparsed, 'my module ComputedModule:auth("x" ~ "y") { }', 'deparse';

    for
      'AST', EVAL($ast),
      'Str', EVAL($deparsed),
      'Raku', EVAL(EVAL $raku)
    -> $type, $module {
        is $module.^name, 'ComputedModule', "$type: the module is declared";
        is-deeply $module.^auth, 'xy', "$type: the module has the computed auth";
    }
}

subtest 'A class whose version is computed in a scope of its own' => {
    # my class ScopedVersionClass:ver(do {
    #     my $x = V;
    #     $x
    # }) {
    #     my constant V = v9;
    #     method v {
    #         V
    #     }
    # }
    my constant V = v3;
    ast RakuAST::Class.new(
      scope => 'my',
      name  => RakuAST::Name.from-identifier('ScopedVersionClass',
        colonpairs => (
          RakuAST::ColonPair::Value.new(
            key   => 'ver',
            value => RakuAST::Circumfix::Parentheses.new(
              RakuAST::SemiList.new(
                RakuAST::Statement::Expression.new(
                  expression => RakuAST::StatementPrefix::Do.new(
                    RakuAST::Block.new(
                      body => RakuAST::Blockoid.new(
                        RakuAST::StatementList.new(
                          RakuAST::Statement::Expression.new(
                            expression => RakuAST::VarDeclaration::Simple.new(
                              sigil       => '$',
                              desigilname => RakuAST::Name.from-identifier('x'),
                              initializer => RakuAST::Initializer::Assign.new(
                                RakuAST::Term::Name.new(
                                  RakuAST::Name.from-identifier('V')
                                )
                              )
                            )
                          ),
                          RakuAST::Statement::Expression.new(
                            expression => RakuAST::Var::Lexical.new('$x')
                          )
                        )
                      )
                    )
                  )
                )
              )
            )
          ),
        )
      ),
      body  => RakuAST::Block.new(
        body => RakuAST::Blockoid.new(
          RakuAST::StatementList.new(
            RakuAST::Statement::Expression.new(
              expression => RakuAST::VarDeclaration::Constant.new(
                scope       => 'my',
                name        => 'V',
                initializer => RakuAST::Initializer::Assign.new(
                  RakuAST::VersionLiteral.new(v9)
                )
              )
            ),
            RakuAST::Statement::Expression.new(
              expression => RakuAST::Method.new(
                name => RakuAST::Name.from-identifier('v'),
                body => RakuAST::Blockoid.new(
                  RakuAST::StatementList.new(
                    RakuAST::Statement::Expression.new(
                      expression => RakuAST::Term::Name.new(
                        RakuAST::Name.from-identifier('V')
                      )
                    )
                  )
                )
              )
            )
          )
        )
      )
    );
    is-deeply $deparsed, q:to/CODE/.chomp, 'deparse';
my class ScopedVersionClass:ver(do {
    my $x = V;
    $x
}) {
    my constant V = v9;
    method v {
        V
    }
}
CODE

    for 'AST', $ast, 'Str', $deparsed, 'Raku', EVAL($raku) -> $type, $it {
        my $class := EVAL($it);
        is-deeply $class.^ver, v3,
          "$type: the version is computed outside the class";
        is-deeply $class.v, v9, "$type: the body keeps its own constant";
    }
}

subtest 'A class whose version dies when it is evaluated' => {
    # my class BoomClass:ver(die("boom")) { }
    ast RakuAST::Class.new(
      scope => 'my',
      name  => RakuAST::Name.from-identifier('BoomClass',
        colonpairs => (
          RakuAST::ColonPair::Value.new(
            key   => 'ver',
            value => RakuAST::Circumfix::Parentheses.new(
              RakuAST::SemiList.new(
                RakuAST::Statement::Expression.new(
                  expression => RakuAST::Call::Name.new(
                    name => RakuAST::Name.from-identifier('die'),
                    args => RakuAST::ArgList.new(RakuAST::StrLiteral.new('boom'))
                  )
                )
              )
            )
          ),
        )
      ),
      body  => RakuAST::Block.new(
        body => RakuAST::Blockoid.new(RakuAST::StatementList.new)
      )
    );
    is-deeply $deparsed, 'my class BoomClass:ver(die("boom")) { }', 'deparse';

    for 'AST', $ast, 'Str', $deparsed, 'Raku', EVAL($raku) -> $type, $it {
        throws-like { EVAL($it) }, Exception, message => 'boom',
          "$type: the exception of the version is thrown";
    }
}

subtest 'A class declared twice in a tree is a redeclaration' => {
    for 'AST', 'Str', 'Raku' -> $type {
        for "Redeclared$type", "Redeclared{$type}::Inner" -> $name {
            # class Redeclared{$type} { }
            # class Redeclared{$type} { }
            #
            # class Redeclared{$type}::Inner { }
            # class Redeclared{$type}::Inner { }
            ast RakuAST::StatementList.new(
              |(^2).map({
                  RakuAST::Statement::Expression.new(
                    expression => RakuAST::Class.new(
                      scope => 'our',
                      name  => RakuAST::Name.from-identifier-parts(|$name.split('::'))
                    )
                  )
              })
            );
            is-deeply $deparsed, "class $name \{ }\nclass $name \{ }\n",
              "$type: deparse of $name";

            throws-like {
                EVAL($type eq 'AST' ?? $ast !! $type eq 'Str' ?? $deparsed !! EVAL($raku))
            }, X::Redeclaration, symbol => $name,
              "$type: redeclaring $name is reported";
        }
    }
}

subtest 'An attribute default checked against a list, code or generic type' => {
    ast Q:to/SOURCE/.AST;
    my @d = 1, 2; my class AttrDefaultArray { has Int @.x = @d }
    SOURCE
    for 'AST', $ast, 'Str', $deparsed, 'Raku', EVAL($raku) -> $type, $it {
        is-deeply EVAL($it).new.x, Array[Int].new(1, 2),
          "$type: an @ attribute default from an array variable";
    }

    ast Q:to/SOURCE/.AST;
    my @d = Int, Int; my class AttrDefaultUndefinedArray { has Int:U @.x = @d }
    SOURCE
    for 'AST', $ast, 'Str', $deparsed, 'Raku', EVAL($raku) -> $type, $it {
        is-deeply EVAL($it).new.x, Array[Int:U].new(Int, Int),
          "$type: an @ attribute of undefined elements from an array of type objects";
    }

    ast Q:to/SOURCE/.AST;
    my %d = a => 1; my class AttrDefaultHash { has Int %.x = %d }
    SOURCE
    for 'AST', $ast, 'Str', $deparsed, 'Raku', EVAL($raku) -> $type, $it {
        is-deeply EVAL($it).new.x, (my Int % = a => 1),
          "$type: a % attribute default from a hash variable";
    }

    ast Q:to/SOURCE/.AST;
    my &d = sub (--> Int) { 42 }; my class AttrDefaultCode { has Int &.x = &d }
    SOURCE
    for 'AST', $ast, 'Str', $deparsed, 'Raku', EVAL($raku) -> $type, $it {
        is EVAL($it).new.x.(), 42,
          "$type: a & attribute default from a code variable";
    }

    ast Q:to/SOURCE/.AST;
    my Any $d = 42; my class AttrDefaultWider { has Int $.x = $d }
    SOURCE
    for 'AST', $ast, 'Str', $deparsed, 'Raku', EVAL($raku) -> $type, $it {
        is EVAL($it).new.x, 42,
          "$type: a \$ attribute default from a variable of a wider type";
    }

    ast Q:to/SOURCE/.AST;
    my class AttrDefaultNative { has Int $.x = my int $ = 42 }
    SOURCE
    for 'AST', $ast, 'Str', $deparsed, 'Raku', EVAL($raku) -> $type, $it {
        is EVAL($it).new.x, 42,
          "$type: a \$ attribute default from a native variable";
    }

    ast Q:to/SOURCE/.AST;
    my role AttrDefaultTypeParam[::T] { has Mu:U $.x = T }
    my class AttrDefaultTypeParamClass does AttrDefaultTypeParam[Int] { }
    SOURCE
    for 'AST', $ast, 'Str', $deparsed, 'Raku', EVAL($raku) -> $type, $it {
        is EVAL($it).new.x, Int,
          "$type: a \$ attribute default from a role type parameter";
    }

    throws-like {
        'my class AttrDefaultWrongValue { has Int:U $.x = 42 }'.AST
    }, X::TypeCheck::Attribute::Default,
      name => '$!x', got => 'Int', expected => 'Int:U',
      'a $ attribute default value of the wrong definedness is reported';

    throws-like {
        'my Str $d = "a"; my class AttrDefaultWrongType { has Int $.x = $d }'.AST
    }, X::TypeCheck::Attribute::Default,
      name => '$!x', got => 'Str', expected => 'Int',
      'a $ attribute default from a variable of an unrelated type is reported';

    throws-like {
        'my @d = 1; my class AttrDefaultWrongList { has Int $.x = @d }'.AST
    }, X::TypeCheck::Attribute::Default,
      name => '$!x', got => 'Positional', expected => 'Int',
      'a $ attribute default from an array variable is reported';
}

