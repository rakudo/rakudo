}

subtest 'Sub with declarator pod on parameter (3)' => {
    # sub a (␤#| leading comment␤$b, $c) { }␤$=pod
    ast RakuAST::Sub.new(
      name      => RakuAST::Name.from-identifier("a"),
      signature => RakuAST::Signature.new(
        parameters => (
          RakuAST::Parameter.new(
            target => RakuAST::ParameterTarget::Var.new(:name<$b>),
            WHY => RakuAST::Doc::Declarator.new(
              leading  => ("leading comment b\n",)
            )
          ),
          RakuAST::Parameter.new(
            target => RakuAST::ParameterTarget::Var.new(:name<$c>),
            WHY => RakuAST::Doc::Declarator.new(
              leading  => ("leading comment c\n",)
            )
          )
        )
      ),
      body      => RakuAST::Blockoid.new(
        RakuAST::StatementList.new()
      )
    );

    is-deeply $deparsed, q:to/CODE/.chomp, 'deparse';
sub a (
  #| leading comment b
  $b,
  #| leading comment c
  $c
) { }, $=pod
CODE

    for 'AST', $ast, 'Str', $deparsed, 'Raku', EVAL($raku) -> $type, $it {
        my ($sub, $pod) := EVAL($it);
        isa-ok $sub, Sub, "$type: did we get a sub";
        is $sub.name, 'a', "$type: did sub get the right name";

        my ($b, $c) = $sub.signature.params.head(2);
        is $b.name, '$b', "$type: did first parameter get the right name";
        is $c.name, '$c', "$type: did second parameter get the right name";

        isa-ok $pod, Array, "$type: did we get an Array";
        is $pod.elems, 2, "$type: does it have two elements";

        for $pod[0], $b, 'b', $pod[1], $c, 'c' -> $declarator, $object, $name {
            isa-ok $declarator, Pod::Block::Declarator,
              "$type: did we get a Pod::Block::Declarator";

            is-deeply $declarator.WHEREFORE, $object,
              "$type: is the object the target of the declarator";
            is-deeply $declarator.leading, "leading comment $name",
              "$type: is the leading comment $name correct";
        }
    }
}

subtest 'Sub with declarator pod on parameter (4)' => {
    # #| leading sub␤sub a (␤#= trailing sub␤#| leading param␤$b␤#=trailing param␤) { }␤$=pod
    ast RakuAST::Sub.new(
      name      => RakuAST::Name.from-identifier("a"),
      signature => RakuAST::Signature.new(
        parameters => (
          RakuAST::Parameter.new(
            target => RakuAST::ParameterTarget::Var.new(:name<$b>)
          ).declarator-docs(
            leading  => ("leading param\n",),
            trailing => ("trailing param\n",)
          )
        )
      ),
      body      => RakuAST::Blockoid.new(
        RakuAST::StatementList.new()
      )
    ).declarator-docs(
      leading  => ("leading sub\n",),
      trailing => ("trailing sub\n",)
    );

    is-deeply $deparsed, q:to/CODE/.chomp, 'deparse';
#| leading sub
sub a ( #= trailing sub
  #| leading param
  $b #= trailing param
) { }, $=pod
CODE

    for 'AST', $ast, 'Str', $deparsed, 'Raku', EVAL($raku) -> $type, $it {
        my ($sub, $pod) := EVAL($it);
        isa-ok $sub, Sub, "$type: did we get a sub";
        is $sub.name, 'a', "$type: did sub get the right name";

        my $b := $sub.signature.params.head;
        is $b.name, '$b', "$type: did parameter get the right name";

        isa-ok $pod, Array, "$type: did we get an Array";
        is $pod.elems, 2, "$type: does it have two elements";

        for $pod[0], $sub, 'sub', $pod[1], $b, 'param' -> $declarator, $object, $name {
            isa-ok $declarator, Pod::Block::Declarator,
              "$type: did we get a Pod::Block::Declarator";

            is-deeply $declarator.WHEREFORE, $object,
              "$type: is the object the target of the declarator";
            is-deeply $declarator.leading, "leading $name",
              "$type: is the leading $name correct";
            is-deeply $declarator.trailing, "trailing $name",
              "$type: is the trailing $name correct";
        }
    }
}

subtest 'a simple lexical var' => {
    # #| leading comment␤my $foo; #= trailing comment␤$=pod
    ast RakuAST::VarDeclaration::Simple.new(
      scope       => "my",
      sigil       => '$',
      desigilname => RakuAST::Name.from-identifier('foo'),
    ).declarator-docs(
      leading  => ("leading B<comment>\n",),
      trailing => ("trailing C<comment>\n",)
    );

    is-deeply $deparsed, q:to/CODE/.chomp, 'deparse';
#| leading B<comment>
my $foo #= trailing C<comment>
, $=pod
CODE

    # since the $=pod semantics are unsure, we're not going
    # to test that here and now

    is-deeply
      $ast.first(RakuAST::Doc::DeclaratorTarget).WHY.paragraphs,
      (RakuAST::Doc::Paragraph.new(
        "leading ",
        RakuAST::Doc::Markup.new(
          letter => "B",
          opener => "<",
          closer => ">",
          atoms  => (
            "comment",
          )
        ),
        "\n"
      ),
      RakuAST::Doc::Paragraph.new(
        "trailing ",
        RakuAST::Doc::Markup.new(
          letter => "C",
          opener => "<",
          closer => ">",
          atoms  => (
            "comment",
          )
        ),
        "\n"
      )
    ),
    'did we find the paragraphs ok';
}

subtest 'Leading pod declarator without a trailing newline' => {
    # #| leading comment␤sub a {␤    42␤}
    ast RakuAST::Sub.new(
      name => RakuAST::Name.from-identifier("a"),
      body => RakuAST::Blockoid.new(
        RakuAST::StatementList.new(
          RakuAST::Statement::Expression.new(
            expression => RakuAST::IntLiteral.new(42)
          )
        )
      )
    ).declarator-docs(
      leading => ("leading comment",)
    ), :no-pod;

    for 'Str', $deparsed, 'Raku', $raku.EVAL.DEPARSE -> $type, $it {
        is-deeply $it, q:to/CODE/.chomp, "$type: deparse";
#| leading comment
sub a {
    42
}
CODE
    }
    for 'AST', $ast, 'Str', $deparsed, 'Raku', EVAL($raku) -> $type, $it {
        is-deeply EVAL($it).WHY.leading, "leading comment",
          "$type: is the leading comment attached";
    }
}


subtest 'A block with declarator docs as an initializer keeps the delimiter' => {
    # my $block = #| this is
    # { #= a block
    #     ;
    # };
    # $block
    ast RakuAST::StatementList.new(
      RakuAST::Statement::Expression.new(
        expression => RakuAST::VarDeclaration::Simple.new(
          sigil       => '$',
          desigilname => RakuAST::Name.from-identifier('block'),
          initializer => RakuAST::Initializer::Assign.new(
            RakuAST::Block.new(
              body => RakuAST::Blockoid.new(
                RakuAST::StatementList.new(RakuAST::Statement::Empty.new)
              )
            ).declarator-docs(
              leading  => ('this is',),
              trailing => ('a block',)
            )
          )
        )
      ),
      RakuAST::Statement::Expression.new(
        expression => RakuAST::Var::Lexical.new('$block')
      )
    ), :no-pod;
    is-deeply $deparsed, Q:to/CODE/, 'deparse';
my $block = #| this is
{ #= a block
    ;
};
$block
CODE

    for 'AST', $ast, 'Str', $deparsed, 'Raku', EVAL($raku) -> $type, $it {
        isa-ok EVAL($it), Block, "$type: the value is the block";
    }
}


subtest 'A documented block with a modifier ends its statement' => {
    # { #= documented
    #     ;
    # } if 1;
    # 42
    ast RakuAST::StatementList.new(
      RakuAST::Statement::Expression.new(
        expression => RakuAST::Block.new(
          body => RakuAST::Blockoid.new(
            RakuAST::StatementList.new(RakuAST::Statement::Empty.new)
          )
        ).declarator-docs(trailing => ('documented',)),
        condition-modifier => RakuAST::StatementModifier::If.new(
          RakuAST::IntLiteral.new(1)
        )
      ),
      RakuAST::Statement::Expression.new(
        expression => RakuAST::IntLiteral.new(42)
      )
    ), :no-pod;
    is-deeply $deparsed, Q:to/CODE/, 'deparse';
{ #= documented
    ;
} if 1;
42
CODE

    for 'AST', $ast, 'Str', $deparsed, 'Raku', EVAL($raku) -> $type, $it {
        is-deeply EVAL($it), 42, "$type: the statement after the block runs";
    }
}


subtest 'A documented onlystar sub' => {
    # proto sub greeble {*} #= type
    # &greeble
    ast RakuAST::StatementList.new(
      RakuAST::Statement::Expression.new(
        expression => RakuAST::Sub.new(
          multiness => 'proto',
          name      => RakuAST::Name.from-identifier('greeble'),
          body      => RakuAST::OnlyStar.new
        ).declarator-docs(trailing => ('type',))
      ),
      RakuAST::Statement::Expression.new(
        expression => RakuAST::Var::Lexical.new('&greeble')
      )
    ), :no-pod;
    is-deeply $deparsed, Q:to/CODE/, 'deparse';
proto sub greeble {*} #= type
&greeble
CODE

    for 'AST', $ast, 'Str', $deparsed, 'Raku', EVAL($raku) -> $type, $it {
        is EVAL($it).WHY.trailing, 'type', "$type: the docs are on the sub";
    }
}


subtest 'An empty line in a leading or trailing doc is kept' => {
    # #| a
    # #| 
    # #| b
    # sub a {
    # #= c
    # #= 
    # #= d
    #     42
    # }
    ast RakuAST::Doc::Declarator.new(
      WHEREFORE => RakuAST::Sub.new(
        name => RakuAST::Name.from-identifier("a"),
        body => RakuAST::Blockoid.new(
          RakuAST::StatementList.new(
            RakuAST::Statement::Expression.new(
              expression => RakuAST::IntLiteral.new(42)
            )
          )
        )
      ),
      leading  => ("a", "", "b"),
      trailing => ("c", "", "d")
    ), :no-pod;

    for 'Str', $deparsed, 'Raku', $raku.EVAL.DEPARSE -> $type, $it {
        is-deeply $it, q:to/CODE/.chomp, "$type: deparse";
#| a
#| 
#| b
sub a {
#= c
#= 
#= d
    42
}
CODE
    }
    is-deeply $deparsed.AST.DEPARSE.chomp, $deparsed,
      'the deparse parses back to itself';
}


subtest 'A subset with a where expression keeps its own leading doc' => {
    # #| d1
    # my enum E <a b>;
    # #| d2
    # my subset S of Any where 1;
    # #| d3
    # my class C { }
    my $ast := Q:to/SOURCE/.AST;
    #| d1
    my enum E <a b>;
    #| d2
    my subset S of Any where 1;
    #| d3
    my class C { }
    SOURCE
    is-deeply $ast.statements.map(*.expression.WHY.leading.head).List,
      ("d1", "d2", "d3"), 'each declaration keeps its own leading doc';
    is-deeply $ast.DEPARSE.AST.DEPARSE, $ast.DEPARSE,
      'the deparse parses back to itself';
}

subtest 'A trailing doc on the last parameter before a return type' => {
    # sub f (
    #   $a, #= first
    #   $b, #= second
    #  --> Int) {
    #     $a + $b
    # }
    ast Q:to/SOURCE/.AST, :no-pod;
    sub f (
      $a, #= first
      $b, #= second
     --> Int) {
        $a + $b
    }
    SOURCE

    for 'Str', $deparsed, 'Raku', $raku.EVAL.DEPARSE -> $type, $it {
        is-deeply $it, q:to/CODE/, "$type: deparse";
sub f (
  $a, #= first
  $b, #= second
 --> Int) {
    $a + $b
}
CODE
    }
    is-deeply $deparsed.AST.DEPARSE, $deparsed,
      'the deparse parses back to itself';
    is-deeply $deparsed.AST.statements.head.expression.signature.parameters.tail.WHY.trailing,
      ('second',), 'the doc stays on the parameter';
}

subtest 'A subset with a where block that declares something keeps its doc' => {
    # #| d1
    # my subset S of Code where {
    #     .signature ~~ :(:$x)
    # };
    # #| d2
    # my subset T of Any where 1
    my $ast := Q:to/SOURCE/.AST;
    #| d1
    my subset S of Code where { .signature ~~ :(:$x) };
    #| d2
    my subset T of Any where 1;
    SOURCE
    is-deeply $ast.statements.map(*.expression.WHY.leading.head).List,
      ("d1", "d2"), 'each subset keeps its own leading doc';
    nok $ast.statements.head.expression.where.WHY,
      'the where block has no doc';
    is-deeply $ast.DEPARSE, Q:to/CODE/, 'deparse';
#| d1
my subset S of Code where {
    .signature ~~ :(:$x)
};
#| d2
my subset T of Any where 1
CODE
    is-deeply $ast.DEPARSE.AST.DEPARSE, $ast.DEPARSE,
      'the deparse parses back to itself';
}

subtest 'A trailing doc on the line where a body closes documents its block' => {
    # my subset S of Int where {
    #     $_ > 1
    # }; #= subset doc
    # my $b = -> $a { #= block doc
    #     42
    # };
    # sub f { #= sub doc
    #     42
    # }
    # my $c = -> $a { #= brace doc
    #     42
    # };
    # sub g { #= stray doc
    #     42
    # }
    # my $d = do { #= do doc
    #     42
    # };
    # (S, $b, &f, $c, &g, $d)
    ast Q:to/SOURCE/.AST, :no-pod;
    my subset S of Int where {
        $_ > 1
    }; #= subset doc
    my $b = -> $a {
        42
    }; #= block doc
    sub f {
        42
    } #= sub doc
    my $c = -> $a { #= brace doc
        42
    };
    sub g {
        42; #= stray doc
    }
    my $d = do {
        42
    }; #= do doc
    (S, $b, &f, $c, &g, $d)
    SOURCE
    is-deeply $deparsed, Q:to/CODE/, 'deparse';
my subset S of Int where {
    $_ > 1
}; #= subset doc
my $b = -> $a { #= block doc
    42
};
sub f { #= sub doc
    42
}
my $c = -> $a { #= brace doc
    42
};
sub g { #= stray doc
    42
}
my $d = do { #= do doc
    42
};
(S, $b, &f, $c, &g, $d)
CODE

    for 'AST', $ast, 'Str', $deparsed.AST, 'Raku', EVAL($raku) -> $type, $tree {
        my @statements := $tree.statements;
        is-deeply @statements[0].expression.WHY.trailing, ('subset doc',),
          "$type: the subset keeps the doc after its where block";
        my $b := @statements[1].expression.initializer.expression;
        is-deeply $b.WHY.trailing, ('block doc',),
          "$type: the block keeps the doc after its body";
        nok $b.signature.parameters.head.WHY,
          "$type: the parameter of the block has no doc";
        is-deeply @statements[2].expression.WHY.trailing, ('sub doc',),
          "$type: the sub keeps the doc after its body";
        my $c := @statements[3].expression.initializer.expression;
        is-deeply $c.WHY.trailing, ('brace doc',),
          "$type: the block keeps the doc after its opening brace";
        nok $c.signature.parameters.head.WHY,
          "$type: the parameter of that block has no doc";
        is-deeply @statements[4].expression.WHY.trailing, ('stray doc',),
          "$type: a sub without parameters takes a doc inside its body";
        is-deeply @statements[5].expression.initializer.expression.blorst.WHY.trailing,
          ('do doc',), "$type: a do block keeps the doc after its body";
    }
    for 'AST', $ast, 'Str', $deparsed, 'Raku', EVAL($raku) -> $type, $it {
        my ($S, $b, $f, $c, $g, $d) := EVAL($it);
        is-deeply ($S.^name, $b(1), $f(), $c(1), $g(), $d), ('S', 42, 42, 42, 42, 42),
          "$type: the code runs";
    }
}

subtest 'The parameters of a documented pointy block go one per line' => {
    # my $b = ->
    #   $a, #= first
    #   $c, #= second
    #  --> Int {
    #     $a + $c
    # };
    # my $d = ->
    #   $a #= only
    # {
    #     $a
    # };
    # my $e = ->
    #   $a, #= first
    #   $c
    # {
    #     $a + $c
    # };
    # my $f = -> #= block
    #   $a #= only
    # {
    #     $a
    # };
    # ($b, $d, $e, $f)
    ast Q:to/SOURCE/.AST, :no-pod;
    my $b = -> $a, #= first
      $c, #= second
      --> Int { $a + $c };
    my $d = -> $a #= only
      { $a };
    my $e = -> $a, #= first
      $c { $a + $c };
    my $f = -> #= block
      $a #= only
      { $a };
    ($b, $d, $e, $f)
    SOURCE
    for 'Str', $deparsed, 'Raku', $raku.EVAL.DEPARSE -> $type, $it {
        is-deeply $it, Q:to/CODE/, "$type: deparse";
my $b = ->
  $a, #= first
  $c, #= second
 --> Int {
    $a + $c
};
my $d = ->
  $a #= only
{
    $a
};
my $e = ->
  $a, #= first
  $c
{
    $a + $c
};
my $f = -> #= block
  $a #= only
{
    $a
};
($b, $d, $e, $f)
CODE
    }
    is-deeply $deparsed.AST.DEPARSE, $deparsed,
      'the deparse parses back to itself';
    is-deeply $deparsed.AST.statements.head.expression.initializer.expression.signature.parameters.map(*.WHY.trailing.head).List,
      ('first', 'second'), 'the docs stay on the parameters';
    is-deeply $deparsed.AST.statements[3].expression.initializer.expression.WHY.trailing,
      ('block',), 'a doc after the arrow stays on the block';
    for 'AST', $ast, 'Str', $deparsed, 'Raku', EVAL($raku) -> $type, $it {
        my ($b, $d, $e, $f) := EVAL($it);
        is-deeply ($b(1, 2), $d(4), $e(1, 2), $f(5)), (3, 4, 3, 5),
          "$type: the blocks run";
    }
}

subtest 'A trailing doc after a body documents the declaration it closes' => {
    # my class A { #= class doc
    #     has $.x; #= attribute doc
    #     method m { #= method doc
    #         my $y = 1;
    #         $y
    #     }
    # }
    # my role R { #= role doc
    #     method m { }
    # }
    # my class B { #= outer doc
    #     class C { #= inner doc
    #         has $.y
    #     }
    #     has $.z
    # }
    # my class E { #= empty doc
    # }
    # sub f { #= sub doc
    #     my $a = 42;
    #     $a
    # }
    # my $g = -> $b { #= block doc
    #     my $c = $b;
    #     $c
    # };
    # sub h { #= next line doc
    #     my $d = 1
    # }
    # sub k {
    # #= first line
    # #= second line
    #     1
    # }
    # my $l = { #= bare block doc
    #     my $e = 1;
    #     $e
    # };
    # (A, R, B, E, &f, $g, &h, &k, $l)
    ast Q:to/SOURCE/.AST, :no-pod;
    my class A {
        has $.x; #= attribute doc
        method m {
            my $y = 1;
            $y
        } #= method doc
    } #= class doc
    my role R {
        method m { }
    } #= role doc
    my class B {
        class C {
            has $.y;
        } #= inner doc
        has $.z;
    } #= outer doc
    my class E {
    } #= empty doc
    sub f {
        my $a = 42;
        $a
    } #= sub doc
    my $g = -> $b {
        my $c = $b;
        $c
    } #= block doc
    sub h {
        my $d = 1;
    }
    #= next line doc
    sub k {
        1
    } #= first line
    #= second line
    my $l = {
        my $e = 1;
        $e
    } #= bare block doc
    (A, R, B, E, &f, $g, &h, &k, $l)
    SOURCE
    is-deeply $deparsed, Q:to/CODE/, 'deparse';
my class A { #= class doc
    has $.x; #= attribute doc
    method m { #= method doc
        my $y = 1;
        $y
    }
}
my role R { #= role doc
    method m { }
}
my class B { #= outer doc
    class C { #= inner doc
        has $.y
    }
    has $.z
}
my class E { #= empty doc
}
sub f { #= sub doc
    my $a = 42;
    $a
}
my $g = -> $b { #= block doc
    my $c = $b;
    $c
};
sub h { #= next line doc
    my $d = 1
}
sub k {
#= first line
#= second line
    1
}
my $l = { #= bare block doc
    my $e = 1;
    $e
};
(A, R, B, E, &f, $g, &h, &k, $l)
CODE

    for 'AST', $ast, 'Str', $deparsed.AST, 'Raku', EVAL($raku) -> $type, $tree {
        my @statements := $tree.statements;
        sub body-statements($package) {
            $package.body.body.statement-list.statements
        }
        is-deeply @statements[0].expression.WHY.trailing, ('class doc',),
          "$type: the class takes the doc after its body";
        is-deeply body-statements(@statements[0].expression).head.expression.WHY.trailing,
          ('attribute doc',), "$type: the attribute in the class keeps its own doc";
        is-deeply body-statements(@statements[0].expression)[1].expression.WHY.trailing,
          ('method doc',), "$type: the method in the class takes the doc after its own body";
        is-deeply @statements[1].expression.WHY.trailing, ('role doc',),
          "$type: the role takes the doc after its body";
        is-deeply @statements[2].expression.WHY.trailing, ('outer doc',),
          "$type: the outer class takes the doc after its body";
        is-deeply body-statements(@statements[2].expression).head.expression.WHY.trailing,
          ('inner doc',), "$type: the inner class takes the doc after its own body";
        is-deeply @statements[3].expression.WHY.trailing, ('empty doc',),
          "$type: a class with an empty body takes the doc after it";
        is-deeply @statements[4].expression.WHY.trailing, ('sub doc',),
          "$type: the sub takes the doc after its body";
        is-deeply @statements[5].expression.initializer.expression.WHY.trailing,
          ('block doc',), "$type: the pointy block takes the doc after its body";
        is-deeply @statements[6].expression.WHY.trailing, ('next line doc',),
          "$type: a doc at the start of the line after the body goes to the sub";
        is-deeply @statements[7].expression.WHY.trailing, ('first line', 'second line'),
          "$type: a doc after the body continues on the next line";
        is-deeply @statements[8].expression.initializer.expression.WHY.trailing,
          ('bare block doc',), "$type: a block takes the doc after its body";
    }
    for 'AST', $ast, 'Str', $deparsed, 'Raku', EVAL($raku) -> $type, $it {
        my ($A, $R, $B, $E, $f, $g, $h, $k, $l) := EVAL($it);
        is-deeply
          ($A.WHY.Str, $A.^attributes[0].WHY.Str, $A.^find_method('m').WHY.Str,
           $R.WHY.Str, $B.WHY.Str, $B.WHO<C>.WHY.Str, $E.WHY.Str, $f.WHY.Str,
           $g.WHY.Str, $h.WHY.Str, $k.WHY.Str, $l.WHY.Str),
          ('class doc', 'attribute doc', 'method doc', 'role doc', 'outer doc',
           'inner doc', 'empty doc', 'sub doc', 'block doc', 'next line doc',
           'first line second line', 'bare block doc'),
          "$type: the docs reach the objects";
        is-deeply ($f(), $g(1), $h(), $k(), $l()), (42, 1, 1, 1, 1),
          "$type: the code runs";
    }
}

subtest 'A trailing doc no declarand claims is a worry at the end of the unit' => {
    # the worry is written to the stderr of the compiling process
    is-run Q['say 42; #= stray doc'.AST],
      :err(/'Missing declarand for trailing declarator doc'/),
      'a trailing doc after the last declarand is reported';
    is-run Q['sub f { 42 } #= sub doc'.AST],
      'a trailing doc the last declarand claims is not';
    is-run Q['no worries; say 42; #= stray doc'.AST],
      'the pragma of the unit silences the report';
}

subtest 'A trailing doc of a regex declaration follows its body' => {
    # my grammar G {
    #     token t { \d } #= token doc
    #     rule r { \w+ } #= rule doc
    #     #| leading regex doc
    #     regex x { \s } #= trailing regex doc
    #     proto token p {*} #= proto doc
    #     method m { }
    # }
    # (G, $=pod)
    ast Q:to/SOURCE/.AST, :no-pod;
    my grammar G {
        token t { \d } #= token doc
        rule r {
            \w+
        } #= rule doc
        #| leading regex doc
        regex x { \s } #= trailing regex doc
        proto token p {*} #= proto doc
        method m { }
    }
    (G, $=pod)
    SOURCE
    is-deeply $deparsed, Q:to/CODE/, 'deparse';
my grammar G {
    token t { \d } #= token doc
    rule r { \w+ } #= rule doc
    #| leading regex doc
    regex x { \s } #= trailing regex doc
    proto token p {*} #= proto doc
    method m { }
}
(G, $=pod)
CODE

    for 'AST', $ast, 'Str', $deparsed, 'Raku', EVAL($raku) -> $type, $it {
        my ($G, $pod) := EVAL($it);
        is-deeply
          ($G.^find_method('t').WHY.Str, $G.^find_method('r').WHY.Str,
           $G.^find_method('x').WHY.leading, $G.^find_method('x').WHY.trailing,
           $G.^find_method('p').WHY.Str),
          ('token doc', 'rule doc', 'leading regex doc', 'trailing regex doc',
           'proto doc'),
          "$type: the docs reach the regexes";
        is-deeply $pod.map(*.WHEREFORE.name).List, ('t', 'r', 'x', 'p'),
          "$type: the docs are collected in order";
        is-deeply (~$G.parse('5', :rule<t>), ~$G.parse('ab', :rule<r>)),
          ('5', 'ab'), "$type: the regexes match";
    }
}

subtest 'A trailing doc on the parameter of a regex declaration stays on it' => {
    # my token t (
    #   $a?, #= first parameter doc
    #   $b? #= second parameter doc
    # ) { \d } #= token doc
    # (&t, $=pod)
    ast Q:to/SOURCE/.AST, :no-pod;
    my token t(
        $a? #= first parameter doc
        , $b? #= second parameter doc
    ) { \d } #= token doc
    (&t, $=pod)
    SOURCE
    is-deeply $deparsed, Q:to/CODE/, 'deparse';
my token t (
  $a?, #= first parameter doc
  $b? #= second parameter doc
) { \d } #= token doc
(&t, $=pod)
CODE

    for 'AST', $ast, 'Str', $deparsed.AST, 'Raku', EVAL($raku) -> $type, $tree {
        my $token := $tree.statements.head.expression;
        is-deeply $token.WHY.trailing, ('token doc',),
          "$type: the token keeps the doc after its body";
        is-deeply $token.signature.parameters.map(*.WHY.trailing).List,
          (('first parameter doc',), ('second parameter doc',)),
          "$type: each parameter keeps its own doc";
    }
    for 'AST', $ast, 'Str', $deparsed, 'Raku', EVAL($raku) -> $type, $it {
        my ($t, $pod) := EVAL($it);
        is-deeply
          ($t.WHY.Str, $t.signature.params[1].WHY.Str,
           $t.signature.params[2].WHY.Str,
           $pod.map(*.WHEREFORE.^name).sort.List),
          ('token doc', 'first parameter doc', 'second parameter doc',
           ('Parameter', 'Parameter', 'Regex')),
          "$type: the docs reach the token and its parameters";
        ok '5' ~~ $t, "$type: the token matches";
    }
}

