}

subtest 'Sub with declarator pod on parameter (3)' => {
    # sub a (␤#| leading comment␤$b, $c) { }␤$=pod
    ast RakuAST::Sub.new(
      name      => RakuAST::Name.from-identifier("a"),
      signature => RakuAST::Signature.new(
        parameters => (
          RakuAST::Parameter.new(
            target => RakuAST::ParameterTarget::Var.new(:name<$b>),
            WHY => RakuAST::Doc::Declarator.new(
              leading  => ("leading comment b\n",)
            )
          ),
          RakuAST::Parameter.new(
            target => RakuAST::ParameterTarget::Var.new(:name<$c>),
            WHY => RakuAST::Doc::Declarator.new(
              leading  => ("leading comment c\n",)
            )
          )
        )
      ),
      body      => RakuAST::Blockoid.new(
        RakuAST::StatementList.new()
      )
    );

    is-deeply $deparsed, q:to/CODE/.chomp, 'deparse';
sub a (
  #| leading comment b
  $b,
  #| leading comment c
  $c
) { }, $=pod
CODE

    for 'AST', $ast, 'Str', $deparsed, 'Raku', EVAL($raku) -> $type, $it {
        my ($sub, $pod) := EVAL($it);
        isa-ok $sub, Sub, "$type: did we get a sub";
        is $sub.name, 'a', "$type: did sub get the right name";

        my ($b, $c) = $sub.signature.params.head(2);
        is $b.name, '$b', "$type: did first parameter get the right name";
        is $c.name, '$c', "$type: did second parameter get the right name";

        isa-ok $pod, Array, "$type: did we get an Array";
        is $pod.elems, 2, "$type: does it have two elements";

        for $pod[0], $b, 'b', $pod[1], $c, 'c' -> $declarator, $object, $name {
            isa-ok $declarator, Pod::Block::Declarator,
              "$type: did we get a Pod::Block::Declarator";

            is-deeply $declarator.WHEREFORE, $object,
              "$type: is the object the target of the declarator";
            is-deeply $declarator.leading, "leading comment $name",
              "$type: is the leading comment $name correct";
        }
    }
}

subtest 'Sub with declarator pod on parameter (4)' => {
    # #| leading sub␤sub a (␤#= trailing sub␤#| leading param␤$b␤#=trailing param␤) { }␤$=pod
    ast RakuAST::Sub.new(
      name      => RakuAST::Name.from-identifier("a"),
      signature => RakuAST::Signature.new(
        parameters => (
          RakuAST::Parameter.new(
            target => RakuAST::ParameterTarget::Var.new(:name<$b>)
          ).declarator-docs(
            leading  => ("leading param\n",),
            trailing => ("trailing param\n",)
          ),
        )
      ),
      body      => RakuAST::Blockoid.new(
        RakuAST::StatementList.new()
      )
    ).declarator-docs(
      leading  => ("leading sub\n",),
      trailing => ("trailing sub\n",)
    );

    is-deeply $deparsed, q:to/CODE/.chomp, 'deparse';
#| leading sub
sub a ( #= trailing sub
  #| leading param
  $b #= trailing param
) { }, $=pod
CODE

    for 'AST', $ast, 'Str', $deparsed, 'Raku', EVAL($raku) -> $type, $it {
        my ($sub, $pod) := EVAL($it);
        isa-ok $sub, Sub, "$type: did we get a sub";
        is $sub.name, 'a', "$type: did sub get the right name";

        my $b := $sub.signature.params.head;
        is $b.name, '$b', "$type: did parameter get the right name";

        isa-ok $pod, Array, "$type: did we get an Array";
        is $pod.elems, 2, "$type: does it have two elements";

        for $pod[0], $sub, 'sub', $pod[1], $b, 'param' -> $declarator, $object, $name {
            isa-ok $declarator, Pod::Block::Declarator,
              "$type: did we get a Pod::Block::Declarator";

            is-deeply $declarator.WHEREFORE, $object,
              "$type: is the object the target of the declarator";
            is-deeply $declarator.leading, "leading $name",
              "$type: is the leading $name correct";
            is-deeply $declarator.trailing, "trailing $name",
              "$type: is the trailing $name correct";
        }
    }
}

subtest 'a simple lexical var' => {
    # #| leading comment␤my $foo; #= trailing comment␤$=pod
    ast RakuAST::VarDeclaration::Simple.new(
      scope       => "my",
      sigil       => '$',
      desigilname => RakuAST::Name.from-identifier('foo'),
    ).declarator-docs(
      leading  => ("leading B<comment>\n",),
      trailing => ("trailing C<comment>\n",)
    );

    is-deeply $deparsed, q:to/CODE/.chomp, 'deparse';
#| leading B<comment>
my $foo #= trailing C<comment>
, $=pod
CODE

    # since the $=pod semantics are unsure, we're not going
    # to test that here and now

    is-deeply
      $ast.first(RakuAST::Doc::DeclaratorTarget).WHY.paragraphs,
      (RakuAST::Doc::Paragraph.new(
        "leading ",
        RakuAST::Doc::Markup.new(
          letter => "B",
          opener => "<",
          closer => ">",
          atoms  => (
            "comment",
          )
        ),
        "\n"
      ),
      RakuAST::Doc::Paragraph.new(
        "trailing ",
        RakuAST::Doc::Markup.new(
          letter => "C",
          opener => "<",
          closer => ">",
          atoms  => (
            "comment",
          )
        ),
        "\n"
      )
    ),
    'did we find the paragraphs ok';
}

subtest 'Leading pod declarator without a trailing newline' => {
    # #| leading comment␤sub a {␤    42␤}
    ast RakuAST::Sub.new(
      name => RakuAST::Name.from-identifier("a"),
      body => RakuAST::Blockoid.new(
        RakuAST::StatementList.new(
          RakuAST::Statement::Expression.new(
            expression => RakuAST::IntLiteral.new(42)
          )
        )
      )
    ).declarator-docs(
      leading => ("leading comment",)
    ), :no-pod;

    for 'Str', $deparsed, 'Raku', $raku.EVAL.DEPARSE -> $type, $it {
        is-deeply $it, q:to/CODE/.chomp, "$type: deparse";
#| leading comment
sub a {
    42
}
CODE
    }
    for 'AST', $ast, 'Str', $deparsed, 'Raku', EVAL($raku) -> $type, $it {
        is-deeply EVAL($it).WHY.leading, "leading comment",
          "$type: is the leading comment attached";
    }
}


subtest 'A block with declarator docs as an initializer keeps the delimiter' => {
    # my $block = #| this is
    # { #= a block
    #     ;
    # };
    # $block
    ast RakuAST::StatementList.new(
      RakuAST::Statement::Expression.new(
        expression => RakuAST::VarDeclaration::Simple.new(
          sigil       => '$',
          desigilname => RakuAST::Name.from-identifier('block'),
          initializer => RakuAST::Initializer::Assign.new(
            RakuAST::Block.new(
              body => RakuAST::Blockoid.new(
                RakuAST::StatementList.new(RakuAST::Statement::Empty.new)
              )
            ).declarator-docs(
              leading  => ('this is',),
              trailing => ('a block',)
            )
          )
        )
      ),
      RakuAST::Statement::Expression.new(
        expression => RakuAST::Var::Lexical.new('$block')
      )
    ), :no-pod;
    is-deeply $deparsed, Q:to/CODE/, 'deparse';
my $block = #| this is
{ #= a block
    ;
};
$block
CODE

    for 'AST', $ast, 'Str', $deparsed, 'Raku', EVAL($raku) -> $type, $it {
        isa-ok EVAL($it), Block, "$type: the value is the block";
    }
}


subtest 'A documented block with a modifier ends its statement' => {
    # { #= documented
    #     ;
    # } if 1;
    # 42
    ast RakuAST::StatementList.new(
      RakuAST::Statement::Expression.new(
        expression => RakuAST::Block.new(
          body => RakuAST::Blockoid.new(
            RakuAST::StatementList.new(RakuAST::Statement::Empty.new)
          )
        ).declarator-docs(trailing => ('documented',)),
        condition-modifier => RakuAST::StatementModifier::If.new(
          RakuAST::IntLiteral.new(1)
        )
      ),
      RakuAST::Statement::Expression.new(
        expression => RakuAST::IntLiteral.new(42)
      )
    ), :no-pod;
    is-deeply $deparsed, Q:to/CODE/, 'deparse';
{ #= documented
    ;
} if 1;
42
CODE

    for 'AST', $ast, 'Str', $deparsed, 'Raku', EVAL($raku) -> $type, $it {
        is-deeply EVAL($it), 42, "$type: the statement after the block runs";
    }
}


subtest 'A documented onlystar sub' => {
    # proto sub greeble {*} #= type
    # &greeble
    ast RakuAST::StatementList.new(
      RakuAST::Statement::Expression.new(
        expression => RakuAST::Sub.new(
          multiness => 'proto',
          name      => RakuAST::Name.from-identifier('greeble'),
          body      => RakuAST::OnlyStar.new
        ).declarator-docs(trailing => ('type',))
      ),
      RakuAST::Statement::Expression.new(
        expression => RakuAST::Var::Lexical.new('&greeble')
      )
    ), :no-pod;
    is-deeply $deparsed, Q:to/CODE/, 'deparse';
proto sub greeble {*} #= type
&greeble
CODE

    for 'AST', $ast, 'Str', $deparsed, 'Raku', EVAL($raku) -> $type, $it {
        is EVAL($it).WHY.trailing, 'type', "$type: the docs are on the sub";
    }
}


subtest 'An empty line in a leading or trailing doc is kept' => {
    # #| a
    # #| 
    # #| b
    # sub a {
    # #= c
    # #= 
    # #= d
    #     42
    # }
    ast RakuAST::Doc::Declarator.new(
      WHEREFORE => RakuAST::Sub.new(
        name => RakuAST::Name.from-identifier("a"),
        body => RakuAST::Blockoid.new(
          RakuAST::StatementList.new(
            RakuAST::Statement::Expression.new(
              expression => RakuAST::IntLiteral.new(42)
            )
          )
        )
      ),
      leading  => ("a", "", "b"),
      trailing => ("c", "", "d")
    ), :no-pod;

    for 'Str', $deparsed, 'Raku', $raku.EVAL.DEPARSE -> $type, $it {
        is-deeply $it, q:to/CODE/.chomp, "$type: deparse";
#| a
#| 
#| b
sub a {
#= c
#= 
#= d
    42
}
CODE
    }
    is-deeply $deparsed.AST.DEPARSE.chomp, $deparsed,
      'the deparse parses back to itself';
}


subtest 'A subset with a where expression keeps its own leading doc' => {
    # #| d1
    # my enum E <a b>;
    # #| d2
    # my subset S of Any where 1;
    # #| d3
    # my class C { }
    my $ast := Q:to/SOURCE/.AST;
    #| d1
    my enum E <a b>;
    #| d2
    my subset S of Any where 1;
    #| d3
    my class C { }
    SOURCE
    is-deeply $ast.statements.map(*.expression.WHY.leading.head).List,
      ("d1", "d2", "d3"), 'each declaration keeps its own leading doc';
    is-deeply $ast.DEPARSE.AST.DEPARSE, $ast.DEPARSE,
      'the deparse parses back to itself';
}

subtest 'A trailing doc on the last parameter before a return type' => {
    # sub f (
    #   $a, #= first
    #   $b, #= second
    #  --> Int) {
    #     $a + $b
    # }
    ast Q:to/SOURCE/.AST, :no-pod;
    sub f (
      $a, #= first
      $b, #= second
     --> Int) {
        $a + $b
    }
    SOURCE

    for 'Str', $deparsed, 'Raku', $raku.EVAL.DEPARSE -> $type, $it {
        is-deeply $it, q:to/CODE/, "$type: deparse";
sub f (
  $a, #= first
  $b, #= second
 --> Int) {
    $a + $b
}
CODE
    }
    is-deeply $deparsed.AST.DEPARSE, $deparsed,
      'the deparse parses back to itself';
    is-deeply $deparsed.AST.statements.head.expression.signature.parameters.tail.WHY.trailing,
      ('second',), 'the doc stays on the parameter';
}

subtest 'A subset with a where block that declares something keeps its doc' => {
    # #| d1
    # my subset S of Code where {
    #     .signature ~~ :(:$x)
    # };
    # #| d2
    # my subset T of Any where 1
    my $ast := Q:to/SOURCE/.AST;
    #| d1
    my subset S of Code where { .signature ~~ :(:$x) };
    #| d2
    my subset T of Any where 1;
    SOURCE
    is-deeply $ast.statements.map(*.expression.WHY.leading.head).List,
      ("d1", "d2"), 'each subset keeps its own leading doc';
    nok $ast.statements.head.expression.where.WHY,
      'the where block has no doc';
    is-deeply $ast.DEPARSE, Q:to/CODE/, 'deparse';
#| d1
my subset S of Code where {
    .signature ~~ :(:$x)
};
#| d2
my subset T of Any where 1
CODE
    is-deeply $ast.DEPARSE.AST.DEPARSE, $ast.DEPARSE,
      'the deparse parses back to itself';
}

subtest 'A trailing doc on the line where a body closes documents its block' => {
    # my subset S of Int where {
    #     $_ > 1
    # }; #= subset doc
    # my $b = -> $a { #= block doc
    #     42
    # };
    # sub f { #= sub doc
    #     42
    # }
    # my $c = -> $a { #= brace doc
    #     42
    # };
    # sub g { #= stray doc
    #     42
    # }
    # my $d = do { #= do doc
    #     42
    # };
    # (S, $b, &f, $c, &g, $d)
    ast Q:to/SOURCE/.AST, :no-pod;
    my subset S of Int where {
        $_ > 1
    }; #= subset doc
    my $b = -> $a {
        42
    }; #= block doc
    sub f {
        42
    } #= sub doc
    my $c = -> $a { #= brace doc
        42
    };
    sub g {
        42; #= stray doc
    }
    my $d = do {
        42
    }; #= do doc
    (S, $b, &f, $c, &g, $d)
    SOURCE
    is-deeply $deparsed, Q:to/CODE/, 'deparse';
my subset S of Int where {
    $_ > 1
}; #= subset doc
my $b = -> $a { #= block doc
    42
};
sub f { #= sub doc
    42
}
my $c = -> $a { #= brace doc
    42
};
sub g { #= stray doc
    42
}
my $d = do { #= do doc
    42
};
(S, $b, &f, $c, &g, $d)
CODE

    for 'AST', $ast, 'Str', $deparsed.AST, 'Raku', EVAL($raku) -> $type, $tree {
        my @statements := $tree.statements;
        is-deeply @statements[0].expression.WHY.trailing, ('subset doc',),
          "$type: the subset keeps the doc after its where block";
        my $b := @statements[1].expression.initializer.expression;
        is-deeply $b.WHY.trailing, ('block doc',),
          "$type: the block keeps the doc after its body";
        nok $b.signature.parameters.head.WHY,
          "$type: the parameter of the block has no doc";
        is-deeply @statements[2].expression.WHY.trailing, ('sub doc',),
          "$type: the sub keeps the doc after its body";
        my $c := @statements[3].expression.initializer.expression;
        is-deeply $c.WHY.trailing, ('brace doc',),
          "$type: the block keeps the doc after its opening brace";
        nok $c.signature.parameters.head.WHY,
          "$type: the parameter of that block has no doc";
        is-deeply @statements[4].expression.WHY.trailing, ('stray doc',),
          "$type: a sub without parameters takes a doc inside its body";
        is-deeply @statements[5].expression.initializer.expression.blorst.WHY.trailing,
          ('do doc',), "$type: a do block keeps the doc after its body";
    }
    for 'AST', $ast, 'Str', $deparsed, 'Raku', EVAL($raku) -> $type, $it {
        my ($S, $b, $f, $c, $g, $d) := EVAL($it);
        is-deeply ($S.^name, $b(1), $f(), $c(1), $g(), $d), ('S', 42, 42, 42, 42, 42),
          "$type: the code runs";
    }
}

subtest 'The parameters of a documented pointy block go one per line' => {
    # my $b = ->
    #   $a, #= first
    #   $c, #= second
    #  --> Int {
    #     $a + $c
    # };
    # my $d = ->
    #   $a #= only
    # {
    #     $a
    # };
    # my $e = ->
    #   $a, #= first
    #   $c
    # {
    #     $a + $c
    # };
    # my $f = -> #= block
    #   $a #= only
    # {
    #     $a
    # };
    # ($b, $d, $e, $f)
    ast Q:to/SOURCE/.AST, :no-pod;
    my $b = -> $a, #= first
      $c, #= second
      --> Int { $a + $c };
    my $d = -> $a #= only
      { $a };
    my $e = -> $a, #= first
      $c { $a + $c };
    my $f = -> #= block
      $a #= only
      { $a };
    ($b, $d, $e, $f)
    SOURCE
    for 'Str', $deparsed, 'Raku', $raku.EVAL.DEPARSE -> $type, $it {
        is-deeply $it, Q:to/CODE/, "$type: deparse";
my $b = ->
  $a, #= first
  $c, #= second
 --> Int {
    $a + $c
};
my $d = ->
  $a #= only
{
    $a
};
my $e = ->
  $a, #= first
  $c
{
    $a + $c
};
my $f = -> #= block
  $a #= only
{
    $a
};
($b, $d, $e, $f)
CODE
    }
    is-deeply $deparsed.AST.DEPARSE, $deparsed,
      'the deparse parses back to itself';
    is-deeply $deparsed.AST.statements.head.expression.initializer.expression.signature.parameters.map(*.WHY.trailing.head).List,
      ('first', 'second'), 'the docs stay on the parameters';
    is-deeply $deparsed.AST.statements[3].expression.initializer.expression.WHY.trailing,
      ('block',), 'a doc after the arrow stays on the block';
    for 'AST', $ast, 'Str', $deparsed, 'Raku', EVAL($raku) -> $type, $it {
        my ($b, $d, $e, $f) := EVAL($it);
        is-deeply ($b(1, 2), $d(4), $e(1, 2), $f(5)), (3, 4, 3, 5),
          "$type: the blocks run";
    }
}

subtest 'A trailing doc after a body documents the declaration it closes' => {
    # my class A { #= class doc
    #     has $.x; #= attribute doc
    #     method m { #= method doc
    #         my $y = 1;
    #         $y
    #     }
    # }
    # my role R { #= role doc
    #     method m { }
    # }
    # my class B { #= outer doc
    #     class C { #= inner doc
    #         has $.y
    #     }
    #     has $.z
    # }
    # my class E { #= empty doc
    # }
    # sub f { #= sub doc
    #     my $a = 42;
    #     $a
    # }
    # my $g = -> $b { #= block doc
    #     my $c = $b;
    #     $c
    # };
    # sub h { #= next line doc
    #     my $d = 1
    # }
    # sub k {
    # #= first line
    # #= second line
    #     1
    # }
    # my $l = { #= bare block doc
    #     my $e = 1;
    #     $e
    # };
    # (A, R, B, E, &f, $g, &h, &k, $l)
    ast Q:to/SOURCE/.AST, :no-pod;
    my class A {
        has $.x; #= attribute doc
        method m {
            my $y = 1;
            $y
        } #= method doc
    } #= class doc
    my role R {
        method m { }
    } #= role doc
    my class B {
        class C {
            has $.y;
        } #= inner doc
        has $.z;
    } #= outer doc
    my class E {
    } #= empty doc
    sub f {
        my $a = 42;
        $a
    } #= sub doc
    my $g = -> $b {
        my $c = $b;
        $c
    } #= block doc
    sub h {
        my $d = 1;
    }
    #= next line doc
    sub k {
        1
    } #= first line
    #= second line
    my $l = {
        my $e = 1;
        $e
    } #= bare block doc
    (A, R, B, E, &f, $g, &h, &k, $l)
    SOURCE
    is-deeply $deparsed, Q:to/CODE/, 'deparse';
my class A { #= class doc
    has $.x; #= attribute doc
    method m { #= method doc
        my $y = 1;
        $y
    }
}
my role R { #= role doc
    method m { }
}
my class B { #= outer doc
    class C { #= inner doc
        has $.y
    }
    has $.z
}
my class E { #= empty doc
}
sub f { #= sub doc
    my $a = 42;
    $a
}
my $g = -> $b { #= block doc
    my $c = $b;
    $c
};
sub h { #= next line doc
    my $d = 1
}
sub k {
#= first line
#= second line
    1
}
my $l = { #= bare block doc
    my $e = 1;
    $e
};
(A, R, B, E, &f, $g, &h, &k, $l)
CODE

    for 'AST', $ast, 'Str', $deparsed.AST, 'Raku', EVAL($raku) -> $type, $tree {
        my @statements := $tree.statements;
        sub body-statements($package) {
            $package.body.body.statement-list.statements
        }
        is-deeply @statements[0].expression.WHY.trailing, ('class doc',),
          "$type: the class takes the doc after its body";
        is-deeply body-statements(@statements[0].expression).head.expression.WHY.trailing,
          ('attribute doc',), "$type: the attribute in the class keeps its own doc";
        is-deeply body-statements(@statements[0].expression)[1].expression.WHY.trailing,
          ('method doc',), "$type: the method in the class takes the doc after its own body";
        is-deeply @statements[1].expression.WHY.trailing, ('role doc',),
          "$type: the role takes the doc after its body";
        is-deeply @statements[2].expression.WHY.trailing, ('outer doc',),
          "$type: the outer class takes the doc after its body";
        is-deeply body-statements(@statements[2].expression).head.expression.WHY.trailing,
          ('inner doc',), "$type: the inner class takes the doc after its own body";
        is-deeply @statements[3].expression.WHY.trailing, ('empty doc',),
          "$type: a class with an empty body takes the doc after it";
        is-deeply @statements[4].expression.WHY.trailing, ('sub doc',),
          "$type: the sub takes the doc after its body";
        is-deeply @statements[5].expression.initializer.expression.WHY.trailing,
          ('block doc',), "$type: the pointy block takes the doc after its body";
        is-deeply @statements[6].expression.WHY.trailing, ('next line doc',),
          "$type: a doc at the start of the line after the body goes to the sub";
        is-deeply @statements[7].expression.WHY.trailing, ('first line', 'second line'),
          "$type: a doc after the body continues on the next line";
        is-deeply @statements[8].expression.initializer.expression.WHY.trailing,
          ('bare block doc',), "$type: a block takes the doc after its body";
    }
    for 'AST', $ast, 'Str', $deparsed, 'Raku', EVAL($raku) -> $type, $it {
        my ($A, $R, $B, $E, $f, $g, $h, $k, $l) := EVAL($it);
        is-deeply
          ($A.WHY.Str, $A.^attributes[0].WHY.Str, $A.^find_method('m').WHY.Str,
           $R.WHY.Str, $B.WHY.Str, $B.WHO<C>.WHY.Str, $E.WHY.Str, $f.WHY.Str,
           $g.WHY.Str, $h.WHY.Str, $k.WHY.Str, $l.WHY.Str),
          ('class doc', 'attribute doc', 'method doc', 'role doc', 'outer doc',
           'inner doc', 'empty doc', 'sub doc', 'block doc', 'next line doc',
           'first line second line', 'bare block doc'),
          "$type: the docs reach the objects";
        is-deeply ($f(), $g(1), $h(), $k(), $l()), (42, 1, 1, 1, 1),
          "$type: the code runs";
    }
}

subtest 'A trailing doc no declarand claims is a worry at the end of the unit' => {
    # the worry is written to the stderr of the compiling process
    is-run Q['say 42; #= stray doc'.AST],
      :err(/'Missing declarand for trailing declarator doc'/),
      'a trailing doc after the last declarand is reported';
    is-run Q['sub f { 42 } #= sub doc'.AST],
      'a trailing doc the last declarand claims is not';
    is-run Q['no worries; say 42; #= stray doc'.AST],
      'the pragma of the unit silences the report';
}

subtest 'A trailing doc no declarand claims is reported on its own line' => {
    # the worry names the line of the doc, not where the parse stood when
    # it was raised
    is-run Q:to/CODE/,
    q:to/SOURCE/.AST;
    my $a = 1;
    say 1; #= stray doc
    my $b = 2;
    SOURCE
    CODE
      :err(/'Missing declarand for trailing declarator doc' \n
            \s+ 'at ' \N+ ':2' \n
            \s+ '------> say 1; #= stray doc<HERE><EOL>' \n/),
      'a doc before the next declaration is reported on its line';
    is-run Q:to/CODE/,
    q:to/SOURCE/.AST;
    my $a = 1;
    say 1; #= stray doc
    say "end";

    SOURCE
    CODE
      :err(/'Missing declarand for trailing declarator doc' \n
            \s+ 'at ' \N+ ':2' \n
            \s+ '------> say 1; #= stray doc<HERE><EOL>' \n/),
      'a doc reported at the end of the unit is reported on its line';
    is-run Q:to/CODE/,
    q:to/SOURCE/.AST;
    my $a = 1;
    say 1; #= first line
    #= second line
    say "end";
    SOURCE
    CODE
      :err(/<?before .* 'at ' \N+ ':2' \n \s+ '------> say 1; #= first line<HERE><EOL>' \n>
            .* 'at ' \N+ ':3' \n \s+ '------> #= second line<HERE><EOL>' \n/),
      'each line of a multi line doc is reported on its own line, in either order';
}

subtest 'A trailing doc of a regex declaration follows its body' => {
    # my grammar G {
    #     token t { \d } #= token doc
    #     rule r { \w+ } #= rule doc
    #     #| leading regex doc
    #     regex x { \s } #= trailing regex doc
    #     proto token p {*} #= proto doc
    #     method m { }
    # }
    # (G, $=pod)
    ast Q:to/SOURCE/.AST, :no-pod;
    my grammar G {
        token t { \d } #= token doc
        rule r {
            \w+
        } #= rule doc
        #| leading regex doc
        regex x { \s } #= trailing regex doc
        proto token p {*} #= proto doc
        method m { }
    }
    (G, $=pod)
    SOURCE
    is-deeply $deparsed, Q:to/CODE/, 'deparse';
my grammar G {
    token t { \d } #= token doc
    rule r { \w+ } #= rule doc
    #| leading regex doc
    regex x { \s } #= trailing regex doc
    proto token p {*} #= proto doc
    method m { }
}
(G, $=pod)
CODE

    for 'AST', $ast, 'Str', $deparsed, 'Raku', EVAL($raku) -> $type, $it {
        my ($G, $pod) := EVAL($it);
        is-deeply
          ($G.^find_method('t').WHY.Str, $G.^find_method('r').WHY.Str,
           $G.^find_method('x').WHY.leading, $G.^find_method('x').WHY.trailing,
           $G.^find_method('p').WHY.Str),
          ('token doc', 'rule doc', 'leading regex doc', 'trailing regex doc',
           'proto doc'),
          "$type: the docs reach the regexes";
        is-deeply $pod.map(*.WHEREFORE.name).List, ('t', 'r', 'x', 'p'),
          "$type: the docs are collected in order";
        is-deeply (~$G.parse('5', :rule<t>), ~$G.parse('ab', :rule<r>)),
          ('5', 'ab'), "$type: the regexes match";
    }
}

subtest 'A trailing doc on the parameter of a regex declaration stays on it' => {
    # my token t (
    #   $a?, #= first parameter doc
    #   $b? #= second parameter doc
    # ) { \d } #= token doc
    # (&t, $=pod)
    ast Q:to/SOURCE/.AST, :no-pod;
    my token t(
        $a? #= first parameter doc
        , $b? #= second parameter doc
    ) { \d } #= token doc
    (&t, $=pod)
    SOURCE
    is-deeply $deparsed, Q:to/CODE/, 'deparse';
my token t (
  $a?, #= first parameter doc
  $b? #= second parameter doc
) { \d } #= token doc
(&t, $=pod)
CODE

    for 'AST', $ast, 'Str', $deparsed.AST, 'Raku', EVAL($raku) -> $type, $tree {
        my $token := $tree.statements.head.expression;
        is-deeply $token.WHY.trailing, ('token doc',),
          "$type: the token keeps the doc after its body";
        is-deeply $token.signature.parameters.map(*.WHY.trailing).List,
          (('first parameter doc',), ('second parameter doc',)),
          "$type: each parameter keeps its own doc";
    }
    for 'AST', $ast, 'Str', $deparsed, 'Raku', EVAL($raku) -> $type, $it {
        my ($t, $pod) := EVAL($it);
        is-deeply
          ($t.WHY.Str, $t.signature.params[1].WHY.Str,
           $t.signature.params[2].WHY.Str,
           $pod.map(*.WHEREFORE.^name).sort.List),
          ('token doc', 'first parameter doc', 'second parameter doc',
           ('Parameter', 'Parameter', 'Regex')),
          "$type: the docs reach the token and its parameters";
        ok '5' ~~ $t, "$type: the token matches";
    }
}

subtest 'A multi line trailing doc keeps the indent of its declaration' => {
    # my class A {
    #     has $.x;
    #     #= first line
    #     #= second line
    #     method m {
    #     #= method line
    #     #= method more
    #         1
    #     }
    # }
    # (A, $=pod)
    ast Q:to/SOURCE/.AST, :no-pod;
    my class A {
        has $.x; #= first line
        #= second line
        method m {
            1
        } #= method line
        #= method more
    }
    (A, $=pod)
    SOURCE
    is-deeply $deparsed, Q:to/CODE/, 'deparse';
my class A {
    has $.x;
    #= first line
    #= second line
    method m {
    #= method line
    #= method more
        1
    }
}
(A, $=pod)
CODE
    is-deeply $deparsed.AST.DEPARSE, $deparsed,
      'the deparse of the deparse is the same text';

    for 'AST', $ast, 'Str', $deparsed, 'Raku', EVAL($raku) -> $type, $it {
        my ($A, $pod) := EVAL($it);
        is-deeply
          ($A.^attributes[0].WHY.trailing, $A.^find_method('m').WHY.trailing),
          ('first line second line', 'method line method more'),
          "$type: both lines of each doc reach the object";
        is-deeply $pod.map(*.WHEREFORE.^name).List, ('Attribute', 'Method'),
          "$type: the docs are collected";
    }
}

subtest 'A trailing doc consumed inside a declaration documents it' => {
    # my class A {
    #     has $.z is rw
    #     #= attribute doc
    #     #= attribute more
    # }
    # my class B {
    #     subset S of Int where * > 1
    #     #= subset doc
    #     #= subset more
    # }
    # my class C {
    #     has $.y is rw #= bracket doc
    # }
    # my class D {
    #     enum E <a b> #= enum doc
    # }
    # (A, B, C, D)
    ast Q:to/SOURCE/.AST, :no-pod;
    my class A {
        has $.z is rw #= attribute doc
        # an ordinary comment between the lines
        #= attribute more
    }
    my class B {
        subset S of Int where * > 1 #= subset doc
        #= subset more
    }
    my class C {
        has $.y is rw #=(bracket doc)
    }
    my class D {
        enum E <a b> #= enum doc
    }
    (A, B, C, D)
    SOURCE
    is-deeply $deparsed, Q:to/CODE/, 'deparse';
my class A {
    has $.z is rw
    #= attribute doc
    #= attribute more
}
my class B {
    subset S of Int where * > 1
    #= subset doc
    #= subset more
}
my class C {
    has $.y is rw #= bracket doc
}
my class D {
    enum E <a b> #= enum doc
}
(A, B, C, D)
CODE

    for 'AST', $ast, 'Str', $deparsed.AST, 'Raku', EVAL($raku) -> $type, $tree {
        my @statements := $tree.statements;
        sub first-statement($package) {
            $package.body.body.statement-list.statements.head.expression
        }
        is-deeply first-statement(@statements[0].expression).WHY.trailing,
          ('attribute doc', 'attribute more'),
          "$type: the attribute takes the docs after its trait";
        is-deeply first-statement(@statements[1].expression).WHY.trailing,
          ('subset doc', 'subset more'),
          "$type: the subset takes the docs after its where expression";
        is-deeply first-statement(@statements[2].expression).WHY.trailing,
          ('bracket doc',),
          "$type: the attribute takes the bracketed doc after its trait";
        is-deeply first-statement(@statements[3].expression).WHY.trailing,
          ('enum doc',),
          "$type: the enum takes the doc after its values";
    }
    for 'AST', $ast, 'Str', $deparsed, 'Raku', EVAL($raku) -> $type, $it {
        my ($A, $B, $C, $D) := EVAL($it);
        is-deeply (5 ~~ $B.WHO<S>, 0 ~~ $B.WHO<S>, $D.WHO<E>.enums.keys.sort.List),
          (True, False, ('a', 'b')),
          "$type: the subset and the enum are declared";
    }
}

subtest 'A term or constant declaration keeps its trailing doc' => {
    # my \t = 42; #= term doc
    # my constant C = 7; #= constant doc
    # t + C
    ast RakuAST::StatementList.new(
      RakuAST::Statement::Expression.new(
        expression => RakuAST::VarDeclaration::Term.new(
          scope       => "my",
          name        => RakuAST::Name.from-identifier("t"),
          initializer => RakuAST::Initializer::Assign.new(
            RakuAST::IntLiteral.new(42)
          )
        ).declarator-docs(trailing => ("term doc",))
      ),
      RakuAST::Statement::Expression.new(
        expression => RakuAST::VarDeclaration::Constant.new(
          scope       => "my",
          name        => "C",
          initializer => RakuAST::Initializer::Assign.new(
            RakuAST::IntLiteral.new(7)
          )
        ).declarator-docs(trailing => ("constant doc",))
      ),
      RakuAST::Statement::Expression.new(
        expression => RakuAST::ApplyInfix.new(
          left  => RakuAST::Term::Name.new(RakuAST::Name.from-identifier("t")),
          infix => RakuAST::Infix.new("+"),
          right => RakuAST::Term::Name.new(RakuAST::Name.from-identifier("C"))
        )
      )
    ), :no-pod;
    is-deeply $deparsed, Q:to/CODE/, 'deparse';
my \t = 42; #= term doc
my constant C = 7; #= constant doc
t + C
CODE

    for 'AST', $ast, 'Str', $deparsed, 'Raku', EVAL($raku) -> $type, $it {
        is-deeply EVAL($it), 49, "$type: the term and the constant have their values";
    }
    for 'AST', $ast, 'Str', $deparsed.AST, 'Raku', EVAL($raku) -> $type, $tree {
        is-deeply $tree.statements.map(*.expression.WHY.trailing).head(2).List,
          (('term doc',), ('constant doc',)),
          "$type: the docs are on the declarations";
    }

    # my \u = 1;
    # #= one
    # #= two
    # my $w = do {
    #     my \x = 5 #= no semicolon
    # };
    # my class K {
    #     my constant D = 42 #= last in a body
    # }
    # u + $w
    my $parsed := Q:to/SOURCE/.AST;
    my \u = 1; #= one
    #= two
    my $w = do {
        my \x = 5 #= no semicolon
    };
    my class K {
        my constant D = 42 #= last in a body
    }
    u + $w
    SOURCE
    is-deeply $parsed.DEPARSE, Q:to/CODE/, 'parsed: deparse';
my \u = 1;
#= one
#= two
my $w = do {
    my \x = 5 #= no semicolon
};
my class K {
    my constant D = 42 #= last in a body
}
u + $w
CODE
    is-deeply $parsed.DEPARSE.AST.DEPARSE, $parsed.DEPARSE,
      'parsed: the deparse of the deparse is the same text';
    my @statements := $parsed.statements;
    is-deeply @statements[0].expression.WHY.trailing, ('one', 'two'),
      'parsed: both lines are on the term declaration';
    is-deeply @statements[1].expression.initializer.expression.blorst
      .body.statement-list.statements.head.expression.WHY.trailing,
      ('no semicolon',),
      'parsed: a term declaration that ends a block takes the doc after its value';
    is-deeply @statements[2].expression.body.body.statement-list.statements
      .head.expression.WHY.trailing, ('last in a body',),
      'parsed: a constant that ends a body takes the doc after its value';
    is-deeply EVAL($parsed), 6, 'parsed: the code runs';
}

subtest 'A statement modifier goes before the trailing doc of its statement' => {
    # my $x = 1;
    # my $y = 2 if $x; #= assign doc
    # my \t = 3 if $x; #= term doc
    # my $z = 4 if $x;
    # #= first line
    # #= second line
    # my token w { \d } if $x; #= token doc
    # proto sub p (|) {*} if $x; #= proto doc
    # sub f { #= sub doc
    #     1
    # } if $x;
    # say qq:to/A/ if qq:to/B/;
    #   body a
    #   A
    #   body b
    #   B
    # ($y, t, $z, &w, &p, &f)
    ast Q:to/SOURCE/.AST, :no-pod;
    my $x = 1;
    my $y = 2 if $x; #= assign doc
    my \t = 3 if $x; #= term doc
    my $z = 4 if $x; #= first line
    #= second line
    my token w { \d } if $x; #= token doc
    proto sub p (|) {*} if $x; #= proto doc
    sub f { 1 } if $x; #= sub doc
    say q:to/A/ if q:to/B/;
      body a
      A
      body b
      B
    ($y, t, $z, &w, &p, &f)
    SOURCE
    is-deeply $deparsed, Q:to/CODE/, 'deparse';
my $x = 1;
my $y = 2 if $x; #= assign doc
my \t = 3 if $x; #= term doc
my $z = 4 if $x;
#= first line
#= second line
my token w { \d } if $x; #= token doc
proto sub p (|) {*} if $x; #= proto doc
sub f { #= sub doc
    1
} if $x;
say qq:to/A/ if qq:to/B/;
  body a
  A
  body b
  B
($y, t, $z, &w, &p, &f)
CODE

    for 'AST', $ast, 'Str', $deparsed.AST, 'Raku', EVAL($raku) -> $type, $tree {
        is-deeply $tree.statements.map({
            .expression.WHY ?? .expression.WHY.trailing.join(' ') !! ''
        }).List,
          ('', 'assign doc', 'term doc', 'first line second line', 'token doc',
           'proto doc', 'sub doc', '', ''),
          "$type: every doc is on its declaration";
        is-deeply $tree.statements.map({ .condition-modifier ?? 1 !! 0 }).List,
          (0, 1, 1, 1, 1, 1, 1, 1, 0),
          "$type: every modifier is on its statement";
    }
    for 'AST', $ast, 'Str', $deparsed, 'Raku', EVAL($raku) -> $type, $it {
        my $out = '';
        my $*OUT = class { method print(*@a) { $out ~= @a.join; True } }.new;
        my @values = EVAL($it);
        is-deeply @values[0..2], (2, 3, 4), "$type: the modified statements ran";
        is-deeply $out, "body a\n\n", "$type: the heredoc of the expression came first";
    }

    # my $c = (my $b = 1 if do {
    #     2
    # });
    # my $d = ($ if 1);
    # my $e = (my $g = 3 if {a => 1});
    # my $f = $_ for 6; #= loop doc
    # my $h = 7 if 1 for 8; #= both
    # ($c, $d, $e)
    my $inside := Q:to/SOURCE/.AST;
    my $c = (my $b = 1 if do { 2 });
    my $d = ($ if 1);
    my $e = (my $g = 3 if { a => 1 });
    my $f = $_ for 6; #= loop doc
    my $h = 7 if 1 for 8; #= both
    ($c, $d, $e)
    SOURCE
    is-deeply $inside.DEPARSE, Q:to/CODE/, 'inside an expression: deparse';
my $c = (my $b = 1 if do {
    2
});
my $d = ($ if 1);
my $e = (my $g = 3 if {a => 1});
my $f = $_ for 6; #= loop doc
my $h = 7 if 1 for 8; #= both
($c, $d, $e)
CODE
    is-deeply $inside.DEPARSE.AST.DEPARSE, $inside.DEPARSE,
      'inside an expression: the deparse of the deparse is the same text';
    is-deeply $inside.statements[3, 4].map(*.expression.WHY.trailing).List,
      (('loop doc',), ('both',)),
      'inside an expression: the docs stay on the declarations with loop modifiers';
    # the frontends differ on what a declaration under a loop modifier
    # leaves behind, so only the modifiers that end in a brace are run
    for 'AST', $inside, 'Str', $inside.DEPARSE, 'Raku', EVAL('use experimental :rakuast; ' ~ $inside.raku) -> $type, $it {
        is-deeply EVAL($it), (1, Any, 3),
          "$type: the modifiers that end in a brace run";
    }
}

subtest 'A leading doc before a lexical documents the lexical' => {
    # #| doc for y
    # my $y = 42;
    # #| doc for rule
    # my %rule;
    # %rule<x> = {
    #     1
    # };
    # #| doc for f
    # sub f {
    # }
    my $ast := Q:to/SOURCE/.AST;
    #| doc for y
    my $y = 42;
    #| doc for rule
    my %rule; %rule<x> = { 1 };
    #| doc for f
    sub f { }
    SOURCE
    my @statements := $ast.statements;
    is-deeply @statements[0].expression.WHY.leading, ('doc for y',),
      'the doc before my $y documents $y';
    is-deeply @statements[1].expression.WHY.leading, ('doc for rule',),
      'the doc before my %rule documents %rule';
    nok @statements[2].first(RakuAST::Block).WHY.defined,
      'the block assigned in the next statement is not documented';
    is-deeply @statements[3].expression.WHY.leading, ('doc for f',),
      'the doc before sub f documents f';

    is-deeply $ast.DEPARSE, Q:to/CODE/, 'deparse';
#| doc for y
my $y = 42;
#| doc for rule
my %rule;
%rule<x> = {
    1
};
#| doc for f
sub f {
}
CODE
    is-deeply $ast.DEPARSE.AST.DEPARSE, $ast.DEPARSE,
      'the deparse parses back to itself';
    is-deeply EVAL('use experimental :rakuast; ' ~ $ast.raku).DEPARSE, $ast.DEPARSE,
      'Raku: the docs survive the .raku round trip';

    # #| doc for f
    # my &f = sub { }
    my $routine := Q:to/SOURCE/.AST;
    #| doc for f
    my &f = sub { }
    SOURCE
    is-deeply $routine.statements[0].expression.WHY.leading, ('doc for f',),
      'the doc before my &f documents &f';
    nok $routine.first(RakuAST::Sub).WHY.defined,
      'the sub assigned to &f is not documented';

    for 'state $s', 'our $o', 'my @a', 'my \t = 1', 'my constant C = 1'
      -> $declaration {
        my $lexical := "#| doc\n$declaration;\nsub g \{ }".AST;
        is-deeply $lexical.statements[0].expression.WHY.leading, ('doc',),
          "the doc before $declaration documents it";
        nok $lexical.statements[1].expression.WHY.defined,
          "the sub after $declaration is not documented";
    }
}

subtest 'A documented type that fails to compose reports its composition error' => {
    plan 7;

    throws-like { Q:to/SOURCE/.AST },
    role AmbiguousRole { }
    role AmbiguousRole { }
    #| leading doc
    class AmbiguousClass does AmbiguousRole { }
    SOURCE
      X::Role::Parametric::NoSuchCandidate, line => 4,
      'a class with a leading doc doing an ambiguous role group';

    throws-like { Q:to/SOURCE/.AST },
    role StubbedRole { method m { ... } }
    class StubbedClass does StubbedRole { }
    #= trailing doc
    SOURCE
      X::Comp::AdHoc, line => 2,
      message => *.contains('must be implemented by StubbedClass'),
      'a class with a trailing doc missing a method its role requires';

    throws-like { Q:to/SOURCE/.AST },
    role MethodRoleA { method m { 1 } }
    role MethodRoleB { method m { 2 } }
    #| leading doc
    class MethodClass does MethodRoleA does MethodRoleB { }
    #= trailing doc
    SOURCE
      X::Role::Unresolved::Method, line => 4,
      'a class with both docs getting a method from two roles';

    throws-like { Q:to/SOURCE/.AST },
    role AttributeRoleA { has $.a }
    role AttributeRoleB { has $.a }
    #| leading doc
    grammar AttributeGrammar does AttributeRoleA does AttributeRoleB { }
    SOURCE
      X::Role::Attribute::Conflicts, line => 4,
      'a grammar with a leading doc getting an attribute from two roles';

    try Q:to/SOURCE/.AST;
    role DeferredRole { }
    role DeferredRole { }
    #| leading doc
    class DeferredClass does DeferredRole { has $.a is nosuchtrait }
    SOURCE
    isa-ok $!, X::Comp::Trait::Unknown,
      'a class with a leading doc and an error in its body reports only that error';
    is $!.?line, 4,
      'the error in the body of a class with a leading doc is reported at its line';

    throws-like { Q:to/SOURCE/.AST },
    #| leading doc
    my native DocumentedNative is repr('P6int') is Int is nativesize(13) { }
    SOURCE
      X::Comp::AdHoc, line => 2,
      message => *.contains('Unsupported int size'),
      'a native type with a leading doc and an unsupported size';
}

subtest 'A documented stub is documented without being composed' => {
    plan 2;

    throws-like { Q:to/SOURCE/.AST },
    #| leading doc
    class NeverDefinedStub { ... }
    SOURCE
      X::Package::Stubbed, line => 2,
      'a class stub with a leading doc that is never defined';

    my $pod := EVAL Q:to/SOURCE/.AST;
    #| role stub doc
    role StubbedDocRole { ... }
    #| role doc
    role StubbedDocRole { }
    #| class stub doc
    class StubbedDocClass { ... }
    #| class doc
    class StubbedDocClass { }
    $=pod
    SOURCE
    is-deeply $pod.map(*.leading).List,
      ('role stub doc', 'role doc', 'class stub doc', 'class doc'),
      'the docs of a role stub and a class stub are in $=pod';
}

subtest 'A documented class built by hand composes with its compiler services' => {
    plan 2;

    my $type := EVAL RakuAST::Class.new(
      name => RakuAST::Name.from-identifier('DocumentedAccessorClass'),
      body => RakuAST::Block.new(
        body => RakuAST::Blockoid.new(
          RakuAST::StatementList.new(
            RakuAST::Statement::Expression.new(
              expression => RakuAST::VarDeclaration::Simple.new(
                scope       => 'has',
                sigil       => '$',
                twigil      => '.',
                desigilname => RakuAST::Name.from-identifier('a')
              )
            )
          )
        )
      )
    ).declarator-docs(leading => ("leading doc\n",));
    is $type.^lookup('a').signature.params[0].type.^name,
      'DocumentedAccessorClass:D',
      'the accessor is generated for the class';
    is $type.WHY.leading, 'leading doc',
      'the class is documented';
}

# vim: expandtab shiftwidth=4
