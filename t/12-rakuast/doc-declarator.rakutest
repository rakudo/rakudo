              expression => RakuAST::VarDeclaration::Simple.new(
                scope => "has",
                sigil => '$',
                twigil => '.',
                desigilname => RakuAST::Name.from-identifier('foo'),
              ).declarator-docs(
                leading  => ("leading comment\n",),
                trailing => ("trailing comment\n",)
              )
            ),
            RakuAST::Statement::Expression.new(
              expression => RakuAST::VarDeclaration::Simple.new(
                scope => "has",
