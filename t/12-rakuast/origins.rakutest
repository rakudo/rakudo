use v6.e.PREVIEW;
use nqp;
use NQPP6QRegex:from<NQP>;
use NQPHLL:from<NQP>;
use Perl6::Compiler:from<NQP>;
use Raku::Grammar:from<NQP>;
use Raku::Actions:from<NQP>;
use lib $*PROGRAM.parent(2).add('packages/Test-Helpers');
use Test;
use Test::Helpers;

plan 5;

subtest "Line of a declaration with its keyword on an earlier line" => {
    plan 3;
    # The span of a declaration starts at its keyword, while the line of
    # its code object and of its reported problems stays the line of its name.
    is EVAL(q[sub
        foo() { }; &foo]).line, 2,
      'a sub reports the line of its name';
    is EVAL(q[class K { method
        m() { } }; K]).^lookup('m').line, 2,
      'a method reports the line of its name';
    throws-like { EVAL q[my
        $x is foo;] }, X::Comp, line => 2,
      'a problem with a variable declaration is reported on the line of its name';
}

subtest "Text of an operator application" => {
    plan 1;
    # A WhateverCode keeps the text of the expression it was made from. The
    # legacy frontend does not keep it.
    if nqp::gethllsym('Raku', 'COMPILER-FRONTEND') eq 'rakuast' {
        is EVAL(q[*.foo(1).bar]).gist, '*.foo(1).bar',
          'a WhateverCode made from a chain of method calls keeps all of its text';
    }
    else {
        skip 'the legacy frontend does not keep the text of a WhateverCode';
    }
}

subtest "Locations" => {
    my $origins;
    my $target = q:to/ORIG/;
my $line = 1;
for ^10 {
#line 10 test.raku
    say "line ", ($line = 2),
        "+++",
        "---",
        "###",
        "^^^";
}
exit(0);
ORIG

    my $comp := Perl6::Compiler.new();
    $comp.language('Raku');
    $comp.parsegrammar(Raku::Grammar);
    $comp.parseactions(Raku::Actions);
    $comp.addstage('syntaxcheck', :before<ast>);
    $comp.addstage('qast', :after<ast>);
    my $root := $comp.compile($target, :target<ast>, :source-name<foo.raku>, :compunit_ok);

    multi sub tp(Str:D $needle) {
        $target.index($needle)
    }
    multi sub tp(Regex:D $needle) {
        ($target ~~ $needle).from
    }

    my @tests =
        (tp('my $line') + 3,
            %( :line(1), :orig-line(1), :file("foo.raku"), :from(tp('my $line') + 3), # Non-key node
                :WHAT(RakuAST::VarDeclaration::Simple) ),
            %( :line(1), :orig-line(1), :file("foo.raku"), :from(tp('my $line')), # Key node
                :WHAT(RakuAST::Statement::Expression) )),
        (tp('for ^10'),
            %( :line(2), :orig-line(2), :file("foo.raku"), from => tp('for ^10'), :WHAT(RakuAST::Statement::For) ),
            %( :line(2), :orig-line(2), :file("foo.raku"), from => tp('for ^10'), :WHAT(RakuAST::Statement::For) )),
        (tp('^10 {'),
            %( :line(2), :orig-line(2), :file("foo.raku"), from => tp('^10 {'), :WHAT(RakuAST::Prefix) ),
            %( :line(2), :orig-line(2), :file("foo.raku"), from => tp('for ^10 {'), :WHAT(RakuAST::Statement::For) )),
        (tp('ine ",'),
            %( :line(10), :orig-line(4), :file("test.raku"), from => tp('"line ",') + 1, :WHAT(RakuAST::QuotedString) ),
            %( :line(10), :orig-line(4), :file("test.raku"), from => tp('say "line'), :WHAT(RakuAST::Statement::Expression) )),
        (tp(', ($line'),
            # The comma belongs to arglist which starts with the first space after `say`
            %( :line(10), :orig-line(4), :file("test.raku"), from => tp('"line ",'), :WHAT(RakuAST::ArgList) ),
            %( :line(10), :orig-line(4), :file("test.raku"), from => tp('say "line'), :WHAT(RakuAST::Statement::Expression) )),
        (tp('$line = 2'),
            %( :line(10), :orig-line(4), :file("test.raku"), from => tp('$line = 2'), :WHAT(RakuAST::ApplyInfix) ),
            %( :line(10), :orig-line(4), :file("test.raku"), from => tp('say "line'), :WHAT(RakuAST::Statement::Expression) )),
        (tp('++",'),
            %( :line(11), :orig-line(5), :file("test.raku"), from => tp('+++",'), :WHAT(RakuAST::QuotedString) ),
            %( :line(10), :orig-line(4), :file("test.raku"), from => tp('say "line'), :WHAT(RakuAST::Statement::Expression) )),
        (tp(/',' \n \s+ '"---'/),
            %( :line(10), :orig-line(4), :file("test.raku"), from => tp('"line ",'), :WHAT(RakuAST::ArgList) ),
            %( :line(10), :orig-line(4), :file("test.raku"), from => tp('say "line'), :WHAT(RakuAST::Statement::Expression) )),
        (tp('--",'),
            %( :line(12), :orig-line(6), :file("test.raku"), from => tp('---",'), :WHAT(RakuAST::QuotedString) ),
            %( :line(10), :orig-line(4), :file("test.raku"), from => tp('say "line'), :WHAT(RakuAST::Statement::Expression) )),
        (tp('##",'),
            %( :line(13), :orig-line(7), :file("test.raku"), from => tp('###",'), :WHAT(RakuAST::QuotedString) ),
            %( :line(10), :orig-line(4), :file("test.raku"), from => tp('say "line'), :WHAT(RakuAST::Statement::Expression) )),
        (tp(";\n}"),
            %( :line(2), :orig-line(2), :file("foo.raku"), from => tp(/\n '#line 10'/), :WHAT(RakuAST::StatementList) ),
            %( :line(2), :orig-line(2), :file("foo.raku"), from => tp(/\n '#line 10'/), :WHAT(RakuAST::StatementList) )),
        (tp('exit(0)'),
            %( :line(16), :orig-line(10), :file("test.raku"), from => tp('exit(0)'), :WHAT(RakuAST::Call::Name) ),
            %( :line(16), :orig-line(10), :file("test.raku"), from => tp('exit(0)'), :WHAT(RakuAST::Statement::Expression) )),
        ;

    plan +@tests;

    for ^@tests -> $test-idx {
        my Int:D $pos = @tests[$test-idx][0];
        subtest "Position " ~ $pos => {
            plan 2;
            for 0,1 -> $key {
                next unless @tests[$test-idx][$key + 1];
                subtest ($key ?? "Key" !! "Non-key") ~ " node" => {
                    my %attrs = @tests[$test-idx][$key + 1];
                    plan %attrs.elems;
                    my $node := $root.locate-node($pos, :$key);
                    my $node-match := $node.origin.as-match;
                    for %attrs.pairs.sort -> (:key($attr), Mu :$value) {
                        given $attr {
                            when 'WHAT' {
                                cmp-ok $node.WHAT, &[~~], $value, "node type";
                            }
                            default {
                                is-deeply $node-match."$attr"(), $value, "attribute $attr";
                            }
                        }
                    }
                }
            }
        }
    }
}

subtest "Spans" => {
    # Every node produced from source text has an origin covering exactly
    # the text of its construct, so a tool can find the source of any node.
    my $source = q:to/SOURCE/;
    my (@a, $x, $y, $a, %h);
    $x = @a[0].foo(1, 2), 3;
    $y ?? $a + 1 !! 2;
    %h<k>:exists;
    -$a++;
    $a.=abs;
    $a = 1 + 2 * 3;
    my Int $v = 1;
    our sub f(Int $p) { }
    multi sub g() { }
    class K is Any {
        has Int $.k is rw;
        method m() { }
        submethod BUILD() { }
    }
    my \t = 5;
    grammar Gr { token t { a } }
    my ($s, $u);
    $s = "a b" ~ q:w{c d} ~ <e f>;
    $u = q:to/H/;
      body
      H
    $s ~~ rx/ ab /;
    SOURCE

    my $comp := Perl6::Compiler.new();
    $comp.language('Raku');
    $comp.parsegrammar(Raku::Grammar);
    $comp.parseactions(Raku::Actions);
    $comp.addstage('syntaxcheck', :before<ast>);
    $comp.addstage('qast', :after<ast>);
    my $root := $comp.compile($source, :target<ast>, :source-name<spans.raku>, :compunit_ok);

    # Nodes by type in depth first order, each node once.
    my %seen;
    my %nodes;
    sub collect($node) {
        return if %seen{$node.WHICH}++;
        %nodes{$node.^name}.push($node);
        $node.visit-children(&collect);
    }
    collect($root);

    # The source text of the node of a type at an index in depth first
    # order, or of the first node of the type a condition holds for.
    sub node(Mu $type, $which) {
        $which ~~ Int
          ?? %nodes{$type.^name}[$which]
          !! %nodes{$type.^name}.first($which)
    }
    sub span(Mu $type, $which = 0) {
        my $origin = node($type, $which).origin;
        $origin
          ?? $source.substr($origin.from, $origin.to - $origin.from)
          !! Nil
    }
    sub from(Mu $type, $which = 0) {
        node($type, $which).origin.from
    }

    plan 27;

    is span(RakuAST::ApplyListInfix), '$x = @a[0].foo(1, 2), 3',
      'a list infix application covers all of its operands';
    is span(RakuAST::ApplyPostfix, 0), '@a[0].foo(1, 2)',
      'a method call covers its invocant';
    is span(RakuAST::ApplyPostfix, 1), '@a[0]',
      'a postcircumfix covers its operand';
    is span(RakuAST::Ternary), '$y ?? $a + 1 !! 2',
      'a ternary covers its condition and both branches';
    is span(RakuAST::ApplyInfix, 1), '$a + 1',
      'an infix application covers both operands';
    is span(RakuAST::ApplyPostfix, 2), '%h<k>:exists',
      'a postcircumfix covers an adverb applied to it';
    is span(RakuAST::ApplyPrefix), '-$a++',
      'a prefix application covers its operand';
    is span(RakuAST::ApplyPostfix, 3), '$a++',
      'a postfix application covers its operand';
    is span(RakuAST::ApplyDottyInfix), '$a.=abs',
      'a mutating method call covers its invocant';
    is span(RakuAST::ApplyInfix, 3), '1 + 2 * 3',
      'an infix application covers a reduced left operand';
    is span(RakuAST::ApplyInfix, 4), '2 * 3',
      'an infix application nested on the right covers its operands';

    is span(RakuAST::VarDeclaration::Signature, 1), 'my ($s, $u)',
      'a list declaration covers its scope declarator';
    is span(RakuAST::VarDeclaration::Simple, *.name eq '$v'), 'my Int $v = 1',
      'a variable declaration covers its scope declarator and type';
    is span(RakuAST::Sub, 0), 'our sub f(Int $p) { }',
      'a sub covers its scope declarator and keyword';
    is span(RakuAST::Sub, 1), 'multi sub g() { }',
      'a multi sub covers its multi declarator';
    is from(RakuAST::Class), $source.index('class K'),
      'a class starts at its package declarator';
    is span(RakuAST::VarDeclaration::Simple, *.name eq '$.k'), 'has Int $.k is rw',
      'an attribute covers its scope declarator';
    is span(RakuAST::Method), 'method m() { }',
      'a method covers its keyword';
    is span(RakuAST::Submethod), 'submethod BUILD() { }',
      'a submethod covers its keyword';
    is span(RakuAST::VarDeclaration::Term), 'my \t = 5',
      'a sigilless declaration covers its scope declarator';
    is from(RakuAST::TokenDeclaration), $source.index('token t'),
      'a token starts at its keyword';

    is span(RakuAST::QuotedString, 1), '"a b"',
      'a double quoted string covers its quotes';
    is span(RakuAST::QuotedString, 2), 'q:w{c d}',
      'a q string covers its adverb and delimiters';
    is span(RakuAST::QuotedString, 3), '<e f>',
      'a quote words term covers its angle brackets';
    is span(RakuAST::Heredoc), 'q:to/H/',
      'a heredoc covers its introducer';
    is span(RakuAST::QuotedRegex), 'rx/ ab /',
      'a quoted regex covers its adverb and delimiters';
    is node(RakuAST::QuotedRegex, 0).body.origin.from, $source.index('ab /'),
      'the body of a quoted regex leaves out its delimiters';
}

if $*DISTRO.is-win {
    todo "is-run is having problems on Windows with multi-line code";
}
subtest "Backtrace with line directive" => {
    plan 1;
    temp %*ENV<RAKUDO_RAKUAST> = 1;
    is-run q:to/SCRIPT/,
                say "ok yet";
                sub bad { die "and here we die..." }
                #line 10 "test.raku"
                # Intentionally skip a line of code
                bad();
                SCRIPT
        "die after a line directive",
        :exitcode(1),
        :out("ok yet\n"),
        :err("and here we die...\n  in sub bad at -e line 2\n  in block <unit> at \"test.raku\" line 11\n\n");
}

# vim: expandtab shiftwidth=4
