use v6.e.PREVIEW;
use lib <t/packages/12-rakuast/lib>;
use Test;
use nqp;

plan 14;

my $ast;
my $deparsed;
my $raku;
sub ast(RakuAST::Node:D $node --> Nil) {
    $ast      := $node;
    $deparsed := $node.DEPARSE;
    $raku     := 'use experimental :rakuast; ' ~ $node.raku;
    diag $deparsed.chomp;
}

subtest 'creating an empty role' => {
    # role Frobnicator { }
    ast RakuAST::Role.new(
      scope => 'my',
      name  => RakuAST::Name.from-identifier('Frobnicator'),
    );
    is-deeply $deparsed, 'my role Frobnicator { }', 'deparse';

    for 'AST', $ast, 'Str', $deparsed, 'Raku', EVAL($raku) -> $type, $it {
        my $role := EVAL($it);
        is $role.^name, 'Frobnicator', "$type: role gets correct name";
        isa-ok $role.new, $role, "$type: does the role auto-pun";

        my $class := RakuAST::Class.new(
          scope  => 'my',
          name   => RakuAST::Name.from-identifier('Zippo'),
          traits => (
            RakuAST::Trait::Does.new($ast),
          )
        ).EVAL;

        is $class.^name, 'Zippo', "$type: class gets correct name";
        my $object := $class.new;
        isa-ok $object, $class, "$type: can it be instantiated";
        todo "needs work on consuming the role" if $type eq 'Str' | 'Raku';
        does-ok $class, $role, "$type: did the role get consumed";
    }
}

subtest 'creating a role with an attribute' => {
    # my role A { has $.a = 42 }
    ast RakuAST::Role.new(
      scope => 'my',
      name  => RakuAST::Name.from-identifier('A'),
      body  => RakuAST::RoleBody.new(
        body => RakuAST::Blockoid.new(
          RakuAST::StatementList.new(
            RakuAST::Statement::Expression.new(
              expression => RakuAST::VarDeclaration::Simple.new(
                scope       => "has",
                sigil       => '$',
                twigil      => '.',
                desigilname => RakuAST::Name.from-identifier('a'),
                initializer => RakuAST::Initializer::Assign.new(
                  RakuAST::IntLiteral.new(42)
                )
              )
            )
          )
        )
      )
    );
    is-deeply $deparsed, q:to/CODE/.chomp, 'deparse';
my role A {
    has $.a = 42
}
CODE

#    for 'AST', $ast, 'Str', $deparsed, 'Raku', EVAL($raku) -> $type, $it {
    for 'Str', $deparsed -> $type, $it {
        my $role := EVAL($it);
        is $role.^name, 'A', "$type: role gets correct name";
        my $none := $role.new;
        isa-ok $none, $role, "$type: does the role auto-pun (1)";
        is-deeply $none.a, 42, "$type: did the attribute get initialized (1)";

        my $one := $role.new(a => 666);
        isa-ok $one, $role, "$type: does the role auto-pun (2)";
        is-deeply $one.a, 666, "$type: did the attribute get initialized (2)";
    }
}

subtest 'creating a role that does another role' => {
    # my role B does Positional { }
    ast RakuAST::Role.new(
      scope  => 'my',
      name   => RakuAST::Name.from-identifier('B'),
      traits => (
        RakuAST::Trait::Does.new(
          RakuAST::Type::Simple.new(
            RakuAST::Name.from-identifier("Positional")
          )
        ),
      )
    );
    is-deeply $deparsed, 'my role B does Positional { }', 'deparse';

    for 'AST', $ast, 'Str', $deparsed, 'Raku', EVAL($raku) -> $type, $it {
        my $role := EVAL($it);
        is $role.^name, 'B', "$type: role gets correct name";
        is-deeply $role.^roles, (Positional,),
          "$type: can we see the roles it does";
        my $none := $role.new;
        isa-ok $none, $role, "$type: does the role auto-pun";
    }
}

subtest 'creating a role that does a parameterized role' => {
    # my role C does Rational[Int,Int] { }
    ast RakuAST::Role.new(
      scope  => 'my',
      name   => RakuAST::Name.from-identifier('C'),
      traits => (
        RakuAST::Trait::Does.new(
          RakuAST::Type::Parameterized.new(
            base-type => RakuAST::Type::Simple.new(
              RakuAST::Name.from-identifier("Rational")
            ),
            args      => RakuAST::ArgList.new(
              RakuAST::Type::Simple.new(
                RakuAST::Name.from-identifier("Int")
              ),
              RakuAST::Type::Simple.new(
                RakuAST::Name.from-identifier("Int")
              )
            )
          )
        ),
      )
    );
    is-deeply $deparsed, 'my role C does Rational[Int, Int] { }', 'deparse';

    for 'AST', $ast, 'Str', $deparsed, 'Raku', EVAL($raku) -> $type, $it {
        my $role := EVAL($it);
        is $role.^name, 'C', "$type: role gets correct name";
        is-deeply $role.^roles, (Rational[Int,Int],Real,Numeric),
          "$type: can we see the roles it does";
        my $zero := $role.new;
        isa-ok $zero, $role, "$type: does the role auto-pun";
        ok $zero == 0, "$type: did we get a rational 0";
        ok $role.new(1,1) == 1, "$type: did we get a rational 1";
        ok $role.new(1,3) == 1/3, "$type: did we get a rational 1/3";
    }
}

subtest 'creating a parameterized role' => {
    # my role D[$a = 42] { method a { $a } }
    ast RakuAST::Role.new(
      scope => 'my',
      name  => RakuAST::Name.from-identifier('D'),
      body  => RakuAST::RoleBody.new(
        body => RakuAST::Blockoid.new(
          RakuAST::StatementList.new(
            RakuAST::Statement::Expression.new(
              expression => RakuAST::Method.new(
                name => RakuAST::Name.from-identifier("a"),
                body => RakuAST::Blockoid.new(
                  RakuAST::StatementList.new(
                    RakuAST::Statement::Expression.new(
                      expression => RakuAST::Var::Lexical.new('$a')
                    )
                  )
                )
              )
            )
          )
        )
      ),
      parameterization => RakuAST::Signature.new(
        parameters => (
          RakuAST::Parameter.new(
            target  => RakuAST::ParameterTarget::Var.new(:name<$a>),
            default => RakuAST::IntLiteral.new(42)
          ),
        )
      )
    );

    is-deeply $deparsed, q:to/CODE/.chomp, 'deparse';
my role D[$a = 42] {
    method a {
        $a
    }
}
CODE

#    for 'AST', $ast, 'Str', $deparsed, 'Raku', EVAL($raku) -> $type, $it {
    for 'Str', $deparsed -> $type, $it {
        my $role := EVAL($it);
        is $role.^name, 'D', "$type: role gets correct name";
        is-deeply $role.^roles, (), "$type: can we see the roles it does";
        my $none := $role.new;
        isa-ok $none, $role, "$type: does the role auto-pun (1)";
        is-deeply $none.a, 42, "$type: did the default value get set";
        my $one := $role.^parameterize(666).new;
        isa-ok $one, $role, "$type: does the role auto-pun (2)";
        is-deeply $one.a, 666, "$type: did the value get set";
    }
}

subtest 'creating a parameterized role with a type capture' => {
    # my role E[::T] { method a (T:D $a) { $a } }
    ast RakuAST::Role.new(
      scope => 'my',
      name  => RakuAST::Name.from-identifier('E'),
      body  => RakuAST::RoleBody.new(
        body => RakuAST::Blockoid.new(
          RakuAST::StatementList.new(
            RakuAST::Statement::Expression.new(
              expression => RakuAST::Method.new(
                name      => RakuAST::Name.from-identifier("a"),
                signature => RakuAST::Signature.new(
                  parameters => (
                    RakuAST::Parameter.new(
                      type => RakuAST::Type::Definedness.new(
                        base-type => RakuAST::Type::Simple.new(
                          RakuAST::Name.from-identifier("T")
                        ),
                        definite  => True
                      ),
                      target => RakuAST::ParameterTarget::Var.new(:name<$a>)
                    ),
                  )
                ),
                body      => RakuAST::Blockoid.new(
                  RakuAST::StatementList.new(
                    RakuAST::Statement::Expression.new(
                      expression => RakuAST::Var::Lexical.new("\$a")
                    )
                  )
                )
              )
            )
          )
        )
      ),
      parameterization => RakuAST::Signature.new(
        parameters => (
          RakuAST::Parameter.new(
            type-captures => (
              RakuAST::Type::Capture.new(
                RakuAST::Name.from-identifier("T")
              ),
            ),
            default       => RakuAST::Type::Simple.new(
              RakuAST::Name.from-identifier("Str")
            )
          ),
        )
      )
    );
    is-deeply $deparsed, q:to/CODE/.chomp, 'deparse';
my role E[::T = Str] {
    method a (T:D $a) {
        $a
    }
}
CODE

#    for 'AST', $ast, 'Str', $deparsed, 'Raku', EVAL($raku) -> $type, $it {
    for 'Str', $deparsed -> $type, $it {
        my $role := EVAL($it);
        is $role.^name, 'E', "$type: role gets correct name";
        is-deeply $role.^roles, (), "$type: can we see the roles it does";
        my $none := $role.new;
        isa-ok $none, $role, "$type: does the role auto-pun (1)";
        is-deeply $none.a("foo"), "foo", "$type: value returned (1)";
        todo ":D not yet being applied in type check";
        dies-ok { $none.a(Str) }, "$type: does uninstantiated type die (1)";
        dies-ok { $none.a(666) }, "$type: does incorrect type die (1)";
        my $one := $role.^parameterize(Int).new;
        isa-ok $one, $role, "$type: does the role auto-pun (2)";
        is-deeply $one.a(42), 42, "$type: value returned (2)";
        todo ":D not yet being applied in type check";
        dies-ok { $one.a(Int) }, "$type: does uninstantiated type die (2)";
        dies-ok { $one.a("foo") }, "$type: does incorrect type die (2)";
    }
}


subtest 'a role with a version in its name' => {
    # my role TestVersioned:ver<0.0.2> {
    #     method test-meth {
    #         42
    #     }
    # }
    ast RakuAST::Role.new(
      scope => 'my',
      name  => RakuAST::Name.from-identifier('TestVersioned',
        colonpairs => (
          RakuAST::ColonPair::Value.new(
            key   => 'ver',
            value => RakuAST::QuotedString.new(
              processors => <words val>,
              segments   => (
                RakuAST::StrLiteral.new('0.0.2'),
              )
            )
          ),
        )
      ),
      body  => RakuAST::RoleBody.new(
        body => RakuAST::Blockoid.new(
          RakuAST::StatementList.new(
            RakuAST::Statement::Expression.new(
              expression => RakuAST::Method.new(
                name => RakuAST::Name.from-identifier('test-meth'),
                body => RakuAST::Blockoid.new(
                  RakuAST::StatementList.new(
                    RakuAST::Statement::Expression.new(
                      expression => RakuAST::IntLiteral.new(42)
                    )
                  )
                )
              )
            )
          )
        )
      )
    );
    is-deeply $deparsed, q:to/CODE/.chomp, 'deparse';
my role TestVersioned:ver<0.0.2> {
    method test-meth {
        42
    }
}
CODE

    for 'AST', $ast, 'Str', $deparsed, 'Raku', EVAL($raku) -> $type, $it {
        my $role := EVAL($it);
        is $role.^ver, v0.0.2, "$type: the role has the version";
        is $role.test-meth, 42, "$type: the role method can be called";
    }
}

subtest 'a role with a version that needs evaluation' => {
    # my role TestVersionedVar:ver($v) { }
    my $v = v1;
    ast RakuAST::Role.new(
      scope => 'my',
      name  => RakuAST::Name.from-identifier('TestVersionedVar',
        colonpairs => (
          RakuAST::ColonPair::Value.new(
            key   => 'ver',
            value => RakuAST::Circumfix::Parentheses.new(
              RakuAST::SemiList.new(
                RakuAST::Statement::Expression.new(
                  expression => RakuAST::Var::Lexical.new('$v')
                )
              )
            )
          ),
        )
      ),
      body  => RakuAST::RoleBody.new(
        body => RakuAST::Blockoid.new(RakuAST::StatementList.new)
      )
    );
    is-deeply $deparsed, 'my role TestVersionedVar:ver($v) { }', 'deparse';

    for 'AST', $ast, 'Str', $deparsed, 'Raku', EVAL($raku) -> $type, $it {
        is-deeply EVAL($it).^ver, v1, "$type: the role has the version";
    }
}

subtest 'A role whose version, auth and api need evaluation' => {
    # my role ComputedRole:ver(1 + 1):auth("x" ~ "y"):api(2 + 1) {
    #     my constant V = $?ROLE.^ver;
    #     method v {
    #         V
    #     }
    # }
    ast RakuAST::Role.new(
      scope => 'my',
      name  => RakuAST::Name.from-identifier('ComputedRole',
        colonpairs => (
          RakuAST::ColonPair::Value.new(
            key   => 'ver',
            value => RakuAST::Circumfix::Parentheses.new(
              RakuAST::SemiList.new(
                RakuAST::Statement::Expression.new(
                  expression => RakuAST::ApplyInfix.new(
                    left  => RakuAST::IntLiteral.new(1),
                    infix => RakuAST::Infix.new('+'),
                    right => RakuAST::IntLiteral.new(1)
                  )
                )
              )
            )
          ),
          RakuAST::ColonPair::Value.new(
            key   => 'auth',
            value => RakuAST::Circumfix::Parentheses.new(
              RakuAST::SemiList.new(
                RakuAST::Statement::Expression.new(
                  expression => RakuAST::ApplyInfix.new(
                    left  => RakuAST::QuotedString.new(
                      segments => (RakuAST::StrLiteral.new('x'),)
                    ),
                    infix => RakuAST::Infix.new('~'),
                    right => RakuAST::QuotedString.new(
                      segments => (RakuAST::StrLiteral.new('y'),)
                    )
                  )
                )
              )
            )
          ),
          RakuAST::ColonPair::Value.new(
            key   => 'api',
            value => RakuAST::Circumfix::Parentheses.new(
              RakuAST::SemiList.new(
                RakuAST::Statement::Expression.new(
                  expression => RakuAST::ApplyInfix.new(
                    left  => RakuAST::IntLiteral.new(2),
                    infix => RakuAST::Infix.new('+'),
                    right => RakuAST::IntLiteral.new(1)
                  )
                )
              )
            )
          ),
        )
      ),
      body  => RakuAST::RoleBody.new(
        body => RakuAST::Blockoid.new(
          RakuAST::StatementList.new(
            RakuAST::Statement::Expression.new(
              expression => RakuAST::VarDeclaration::Constant.new(
                scope       => 'my',
                name        => 'V',
                initializer => RakuAST::Initializer::Assign.new(
                  RakuAST::ApplyPostfix.new(
                    operand => RakuAST::Var::Compiler::Lookup.new('$?ROLE'),
                    postfix => RakuAST::Call::MetaMethod.new(name => 'ver')
                  )
                )
              )
            ),
            RakuAST::Statement::Expression.new(
              expression => RakuAST::Method.new(
                name => RakuAST::Name.from-identifier('v'),
                body => RakuAST::Blockoid.new(
                  RakuAST::StatementList.new(
                    RakuAST::Statement::Expression.new(
                      expression => RakuAST::Term::Name.new(
                        RakuAST::Name.from-identifier('V')
                      )
                    )
                  )
                )
              )
            )
          )
        )
      )
    );
    is-deeply $deparsed, q:to/CODE/.chomp, 'deparse';
my role ComputedRole:ver(1 + 1):auth("x" ~ "y"):api(2 + 1) {
    my constant V = $?ROLE.^ver;
    method v {
        V
    }
}
CODE

    for 'AST', $ast, 'Str', $deparsed, 'Raku', EVAL($raku) -> $type, $it {
        my $role := EVAL($it);
        is-deeply $role.^ver, v2, "$type: the role has the computed version";
        is-deeply $role.^auth, 'xy', "$type: the role has the computed auth";
        is-deeply $role.^api, '3', "$type: the role has the computed api";
        is-deeply $role.v, v2, "$type: the body sees the version at BEGIN time";
    }
}

subtest 'A parameterized role whose version needs evaluation' => {
    # my role ComputedParameterized:ver(1 + 1)[::T] {
    #     method t {
    #         T
    #     }
    # }
    ast RakuAST::Role.new(
      scope            => 'my',
      name             => RakuAST::Name.from-identifier('ComputedParameterized',
        colonpairs => (
          RakuAST::ColonPair::Value.new(
            key   => 'ver',
            value => RakuAST::Circumfix::Parentheses.new(
              RakuAST::SemiList.new(
                RakuAST::Statement::Expression.new(
                  expression => RakuAST::ApplyInfix.new(
                    left  => RakuAST::IntLiteral.new(1),
                    infix => RakuAST::Infix.new('+'),
                    right => RakuAST::IntLiteral.new(1)
                  )
                )
              )
            )
          ),
        )
      ),
      body             => RakuAST::RoleBody.new(
        body => RakuAST::Blockoid.new(
          RakuAST::StatementList.new(
            RakuAST::Statement::Expression.new(
              expression => RakuAST::Method.new(
                name => RakuAST::Name.from-identifier('t'),
                body => RakuAST::Blockoid.new(
                  RakuAST::StatementList.new(
                    RakuAST::Statement::Expression.new(
                      expression => RakuAST::Type::Simple.new(
                        RakuAST::Name.from-identifier('T')
                      )
                    )
                  )
                )
              )
            )
          )
        )
      ),
      parameterization => RakuAST::Signature.new(
        parameters => (
          RakuAST::Parameter.new(
            type-captures => (
              RakuAST::Type::Capture.new(
                RakuAST::Name.from-identifier('T')
              ),
            )
          ),
        )
      )
    );
    is-deeply $deparsed, q:to/CODE/.chomp, 'deparse';
my role ComputedParameterized:ver(1 + 1)[::T] {
    method t {
        T
    }
}
CODE

    for 'AST', $ast, 'Str', $deparsed, 'Raku', EVAL($raku) -> $type, $it {
        my $role := EVAL($it);
        is-deeply $role.^ver, v2, "$type: the role has the computed version";
        is-deeply $role.^parameterize(Int).new.t, Int,
          "$type: the parameterization is kept";
    }
}

subtest 'A role with a literal version and an auth from $?DISTRIBUTION' => {
    # my role DistributionAuth:ver<0.1>:auth($?DISTRIBUTION.meta<auth>) { }
    ast RakuAST::Role.new(
      scope => 'my',
      name  => RakuAST::Name.from-identifier('DistributionAuth',
        colonpairs => (
          RakuAST::ColonPair::Value.new(
            key   => 'ver',
            value => RakuAST::QuotedString.new(
              processors => <words val>,
              segments   => (RakuAST::StrLiteral.new('0.1'),)
            )
          ),
          RakuAST::ColonPair::Value.new(
            key   => 'auth',
            value => RakuAST::Circumfix::Parentheses.new(
              RakuAST::SemiList.new(
                RakuAST::Statement::Expression.new(
                  expression => RakuAST::ApplyPostfix.new(
                    operand => RakuAST::ApplyPostfix.new(
                      operand => RakuAST::Var::Compiler::Distribution.new,
                      postfix => RakuAST::Call::Method.new(
                        name => RakuAST::Name.from-identifier('meta')
                      )
                    ),
                    postfix => RakuAST::Postcircumfix::LiteralHashIndex.new(
                      index => RakuAST::QuotedString.new(
                        processors => <words val>,
                        segments   => (RakuAST::StrLiteral.new('auth'),)
                      )
                    )
                  )
                )
              )
            )
          ),
        )
      ),
      body  => RakuAST::RoleBody.new(
        body => RakuAST::Blockoid.new(RakuAST::StatementList.new)
      )
    );
    is-deeply $deparsed,
      'my role DistributionAuth:ver<0.1>:auth($?DISTRIBUTION.meta<auth>) { }',
      'deparse';

    for 'AST', $ast, 'Str', $deparsed, 'Raku', EVAL($raku) -> $type, $it {
        my $role := EVAL($it);
        is-deeply $role.^ver, v0.1, "$type: the role has the literal version";
        is-deeply $role.^auth, '', "$type: outside a distribution the role has no auth";
    }
}

subtest 'A role whose version names a constant its body redeclares' => {
    # my role ScopedVersionRole:ver(V) {
    #     my constant V = v9;
    #     method v {
    #         V
    #     }
    # }
    my constant V = v3;
    ast RakuAST::Role.new(
      scope => 'my',
      name  => RakuAST::Name.from-identifier('ScopedVersionRole',
        colonpairs => (
          RakuAST::ColonPair::Value.new(
            key   => 'ver',
            value => RakuAST::Circumfix::Parentheses.new(
              RakuAST::SemiList.new(
                RakuAST::Statement::Expression.new(
                  expression => RakuAST::Term::Name.new(
                    RakuAST::Name.from-identifier('V')
                  )
                )
              )
            )
          ),
        )
      ),
      body  => RakuAST::RoleBody.new(
        body => RakuAST::Blockoid.new(
          RakuAST::StatementList.new(
            RakuAST::Statement::Expression.new(
              expression => RakuAST::VarDeclaration::Constant.new(
                scope       => 'my',
                name        => 'V',
                initializer => RakuAST::Initializer::Assign.new(
                  RakuAST::VersionLiteral.new(v9)
                )
              )
            ),
            RakuAST::Statement::Expression.new(
              expression => RakuAST::Method.new(
                name => RakuAST::Name.from-identifier('v'),
                body => RakuAST::Blockoid.new(
                  RakuAST::StatementList.new(
                    RakuAST::Statement::Expression.new(
                      expression => RakuAST::Term::Name.new(
                        RakuAST::Name.from-identifier('V')
                      )
                    )
                  )
                )
              )
            )
          )
        )
      )
    );
    is-deeply $deparsed, q:to/CODE/.chomp, 'deparse';
my role ScopedVersionRole:ver(V) {
    my constant V = v9;
    method v {
        V
    }
}
CODE

    for 'AST', $ast, 'Str', $deparsed, 'Raku', EVAL($raku) -> $type, $it {
        my $role := EVAL($it);
        is-deeply $role.^ver, v3,
          "$type: the version is computed outside the role";
        is-deeply $role.v, v9, "$type: the body keeps its own constant";
    }
}

subtest 'A role whose version dies when it is evaluated' => {
    # my role BoomRole:ver(die("boom")) { }
    ast RakuAST::Role.new(
      scope => 'my',
      name  => RakuAST::Name.from-identifier('BoomRole',
        colonpairs => (
          RakuAST::ColonPair::Value.new(
            key   => 'ver',
            value => RakuAST::Circumfix::Parentheses.new(
              RakuAST::SemiList.new(
                RakuAST::Statement::Expression.new(
                  expression => RakuAST::Call::Name.new(
                    name => RakuAST::Name.from-identifier('die'),
                    args => RakuAST::ArgList.new(RakuAST::StrLiteral.new('boom'))
                  )
                )
              )
            )
          ),
        )
      ),
      body  => RakuAST::RoleBody.new(
        body => RakuAST::Blockoid.new(RakuAST::StatementList.new)
      )
    );
    is-deeply $deparsed, 'my role BoomRole:ver(die("boom")) { }', 'deparse';

    for 'AST', $ast, 'Str', $deparsed, 'Raku', EVAL($raku) -> $type, $it {
        throws-like { EVAL($it) }, Exception, message => 'boom',
          "$type: the exception of the version is thrown";
    }
}

subtest 'A role declarator a module added declares a role' => {
    my $parsed := Q:to/CODE/.AST;
use CustomRoleDeclarator;
my custom-role CustomParsedRole {
    method m { 42 }
}
CODE
    isa-ok $parsed.statements[1].expression, RakuAST::Role,
      'parsed: a declarator whose HOW is a role HOW makes a role';

    my $role := EVAL($parsed);
    is $role.HOW.^name, 'CustomRoleHOW',
      "AST: the role is made with the declarator's HOW";
    is-deeply $role.new.m, 42, 'AST: the role puns';

    if nqp::gethllsym('Raku', 'COMPILER-FRONTEND') eq 'rakuast' {
        my $role := EVAL($parsed.DEPARSE);
        is $role.HOW.^name, 'CustomRoleHOW',
          "Str: the role is made with the declarator's HOW";
        is-deeply $role.new.m, 42, 'Str: the role puns';
    }
    else {
        skip 'a custom role declarator is a RakuAST frontend feature', 2;
    }

    my $generic := EVAL Q:to/CODE/.AST;
use CustomRoleDeclarator;
my custom-role CustomGenericRole[::T] {
    method t { T }
}
CustomGenericRole
CODE
    is $generic.^candidates.head.HOW.^name, 'CustomRoleHOW',
      "AST: a parameterized role is made with the declarator's HOW";
    is-deeply $generic.^parameterize(Int).new.t, Int,
      'AST: the parameterized role takes its type argument';

    my $unit := EVAL Q:to/CODE/.AST;
use CustomRoleDeclarator;
unit custom-role CustomUnitRole;
method m { 42 }
CODE
    is $unit.HOW.^name, 'CustomRoleHOW',
      "AST: a unit scoped role is made with the declarator's HOW";
    is-deeply $unit.new.m, 42, 'AST: the unit scoped role puns';
}

# vim: expandtab shiftwidth=4
